---
import type { GetStaticPaths } from 'astro';

import { getCompany, getOpenJobs } from '../../../lib/content.ts';
import JobDetailPage from '../../../templates/JobDetailPage.astro';

export const getStaticPaths = (async () => {
  const jobs = await getOpenJobs();
  const paths = [];
  for (const job of jobs) {
    const company = await getCompany(job.data.company.id);
    // The schema guarantees the reference resolves; skip defensively rather
    // than crashing a whole build over one bad entry.
    if (!company) continue;
    paths.push({ params: { slug: job.id }, props: { job, company } });
  }
  return paths;
}) satisfies GetStaticPaths;

const { job, company } = Astro.props;
---

<JobDetailPage job={job} company={company} locale="en" />
