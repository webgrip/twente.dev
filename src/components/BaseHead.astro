---
import { LOCALE_TAGS, SITE_URL } from '../i18n/config.ts';
import type { Locale } from '../i18n/config.ts';
import { absoluteUrl, getAlternates, slugFor, useTranslations } from '../i18n/utils.ts';
import type { SlugInput } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import type { RouteKey } from '../i18n/routes.ts';
import { organisationSchema, websiteSchema } from '../lib/jsonld.ts';
import { ANALYTICS_TOKEN } from '../config/site.ts';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import plexMonoWoff2 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';

/**
 * Every SEO-critical tag lives here, driven by props, so it is structurally
 * impossible to ship a page without a canonical, hreflang alternates or an OG
 * image. Per the plan (§7) this is wired into the base layout rather than
 * repeated per page precisely so it cannot be forgotten.
 */
interface Props {
  locale: Locale;
  routeKey: RouteKey;
  slug?: SlugInput;
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  /** Page-specific structured data, appended to the site-wide graph. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /**
   * The 404 page. An error page answers for *every* unmatched URL on the
   * domain, so it must not claim a canonical URL, hreflang alternates or an
   * og:url — each would declare "I am canonically the homepage" for URLs
   * that are nothing of the sort. It also keeps its own honest title instead
   * of the homepage's tagline treatment.
   */
  errorPage?: boolean;
}

const {
  locale,
  routeKey,
  slug,
  title,
  description,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
  errorPage = false,
} = Astro.props;

const t = useTranslations(locale);
const siteName = t('site.name');

const isHome = routeKey === 'home' && !slug && !errorPage;

// The homepage's <title> should not read "twente.dev — twente.dev".
const fullTitle = isHome ? `${siteName} — ${t('site.tagline')}` : `${title} — ${siteName}`;

// Shares of the homepage should carry the tagline too, not the bare brand name.
const ogTitle = isHome ? fullTitle : title;

const canonicalSlug = slugFor(slug, locale);
const canonical = absoluteUrl(routePath(routeKey, locale, canonicalSlug));
const { alternates, xDefault } = getAlternates(routeKey, slug);

/**
 * Open Graph image: the brand pack's social banner (1200×627). It carries the
 * "Reconnect" campaign lockup (twente.dev/001 · 07.10 · Enschede), which per
 * the playbook is the launch-phase device — replace or generalise it after
 * edition 001. A per-page generator (plan lever L7) can override this later.
 */
const ogImage: string | undefined = absoluteUrl('/brand/twente-dev-social-banner.png');
const ogImageAlt = `${siteName} — ${t('site.tagline')}`;

// `summary_large_image` promises an image; without one, `summary` is honest.
const twitterCard = ogImage ? 'summary_large_image' : 'summary';

const graph = [organisationSchema(), websiteSchema(), ...jsonLd];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
{!errorPage && <link rel="canonical" href={canonical} />}

{noindex && <meta name="robots" content="noindex, nofollow" />}

{
  !errorPage &&
    alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)
}
{!errorPage && xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
{!errorPage && <meta property="og:url" content={canonical} />}
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={LOCALE_TAGS[locale].replace('-', '_')} />
{
  ogImage && (
    <>
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="627" />
      <meta property="og:image:alt" content={ogImageAlt} />
    </>
  )
}

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
{ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}

<!-- Browser chrome matches the page's warm paper / ink grounds. Values are
     the --bg token from src/styles/tokens.css; change together. -->
<meta name="theme-color" content="#f7f3ea" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#111820" media="(prefers-color-scheme: dark)" />

<!-- The two fonts on every page's critical path (body face + the mono
     wordmark in the header). Preloading skips the HTML → CSS → font
     discovery chain and shortens the font-display:swap FOUT window. -->
<link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={plexMonoWoff2} crossorigin />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${siteName} — ${t('blog.title')}`}
  href={`${SITE_URL}/${locale}/rss.xml`}
/>
<link
  rel="alternate"
  type="text/calendar"
  title={`${siteName} — ${t('events.title')}`}
  href={`${SITE_URL}/events.ics`}
/>

<script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />

{
  /**
   * Cloudflare Web Analytics (ADR-0006) — renders only once a token exists in
   * src/config/site.ts. Enabling it also requires widening the CSP in
   * astro.config.mjs: add https://static.cloudflareinsights.com to
   * scriptDirective.resources and https://cloudflareinsights.com to
   * connect-src. Cookieless, so no consent banner — but the privacy page's
   * "no third-party scripts" wording must be updated in the same change.
   */
  ANALYTICS_TOKEN && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: ANALYTICS_TOKEN })}
    />
  )
}
