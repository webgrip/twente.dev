---
interface Tab {
  id: string;
  label: string;
}

interface Props {
  id: string;
  label: string;
  tabs: Tab[];
}

const { id, label, tabs } = Astro.props;
---

<div class="tabs" id={id} data-tabs>
  <ul class="tabs-list" aria-label={label} data-tabs-list>
    {tabs.map((tab) => <li>
      <a class="tabs-tab" id={`${tab.id}-tab`} href={`#${tab.id}`} data-tabs-tab={tab.id}>
        {tab.label}
      </a>
    </li>)}
  </ul>
  <div class="tabs-panels"><slot /></div>
</div>

<style>
  .tabs-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
    border-block-end: var(--border-width) solid var(--border);
  }

  .tabs-list li {
    margin: 0;
  }

  .tabs-tab {
    display: block;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-caps);
    color: var(--fg-muted);
    text-decoration: none;
    border-block-end: 2px solid transparent;
    margin-block-end: -1px;
  }

  .tabs-tab:hover {
    color: var(--fg);
    background: var(--bg-subtle);
  }

  .tabs-tab[aria-selected='true'] {
    color: var(--accent-strong);
    border-block-end-color: var(--accent);
    font-weight: var(--weight-semibold);
  }

  .tabs-panels > :global([data-tabs-panel]) {
    padding-block-start: var(--space-5);
  }

  .tabs-panels :global([data-tabs-panel] > * + *) {
    margin-block-start: var(--space-4);
  }

  .tabs-panels :global([data-tabs-panel] ul) {
    padding-inline-start: var(--space-5);
  }

  .tabs-panels :global([data-tabs-panel] li + li) {
    margin-block-start: var(--space-2);
  }

  .tabs-panels > :global([data-tabs-panel] + [data-tabs-panel]) {
    border-block-start: var(--border-width) solid var(--border);
    margin-block-start: var(--space-5);
  }

  :global([data-tabs-ready]) .tabs-panels > :global([data-tabs-panel] + [data-tabs-panel]) {
    border-block-start: 0;
    margin-block-start: 0;
  }

  :global([data-tabs-panel]:focus-visible) {
    outline: none;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const list = root.querySelector<HTMLElement>('[data-tabs-list]');
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[data-tabs-tab]')];
    if (!list || tabs.length === 0) continue;

    const panels = new Map<string, HTMLElement>();
    for (const tab of tabs) {
      const id = tab.dataset.tabsTab ?? '';
      const panel = document.getElementById(id);
      if (!panel) continue;
      panels.set(id, panel);
    }
    if (panels.size !== tabs.length) continue;

    list.setAttribute('role', 'tablist');
    for (const item of list.querySelectorAll('li')) item.setAttribute('role', 'presentation');

    for (const [id, panel] of panels) {
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', `${id}-tab`);
      panel.tabIndex = 0;
      panel.querySelector('[data-tabs-heading]')?.setAttribute('hidden', '');
    }

    for (const tab of tabs) {
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', tab.dataset.tabsTab ?? '');
    }

    const select = (id: string, moveFocus: boolean) => {
      for (const tab of tabs) {
        const selected = tab.dataset.tabsTab === id;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && moveFocus) tab.focus();
      }
      for (const [panelId, panel] of panels) panel.hidden = panelId !== id;
    };

    const openFromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      return panels.has(id) ? id : null;
    };

    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        const id = tab.dataset.tabsTab ?? '';
        select(id, false);
        history.replaceState(null, '', `#${id}`);
      });

      tab.addEventListener('keydown', (event) => {
        const offset =
          event.key === 'ArrowRight'
            ? 1
            : event.key === 'ArrowLeft'
              ? -1
              : event.key === 'Home'
                ? -index
                : event.key === 'End'
                  ? tabs.length - 1 - index
                  : 0;
        if (offset === 0) return;
        event.preventDefault();
        const next = tabs[(index + offset + tabs.length) % tabs.length];
        const id = next?.dataset.tabsTab;
        if (!id) return;
        select(id, true);
        history.replaceState(null, '', `#${id}`);
      });
    }

    window.addEventListener('hashchange', () => {
      const id = openFromHash();
      if (id) select(id, false);
    });

    root.setAttribute('data-tabs-ready', '');
    select(openFromHash() ?? tabs[0]?.dataset.tabsTab ?? '', false);
  }
</script>
