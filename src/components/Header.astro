---
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/utils.ts';
import type { SlugInput } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import type { RouteKey } from '../i18n/routes.ts';
import LocaleSwitcher from './LocaleSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  current: RouteKey;
  slug?: SlugInput;
}

const { locale, current, slug } = Astro.props;
const t = useTranslations(locale);

// Order mirrors the playbook's information architecture: events and community
// lead, then the directory. Partners is a B2B page most visitors never need;
// it moved to the footer.
const navItems: { key: RouteKey; label: string }[] = [
  { key: 'events', label: t('nav.events') },
  { key: 'companies', label: t('nav.companies') },
  { key: 'blog', label: t('nav.blog') },
  { key: 'communities', label: t('nav.communities') },
  { key: 'contribute', label: t('nav.contribute') },
  { key: 'search', label: t('search.label') },
];
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href={routePath('home', locale)}>
      {
        /* The compact mark (t.d, ratified 2026-08-30) inlined rather than
          <img src="/brand/mark.svg">: inline, the badge follows currentColor,
          so it is ink on paper in light mode and paper on ink in dark, with
          the letters knocked out to the page background. A referenced file
          would need two assets and would still be wrong at the theme switch.
          Geometry is copied verbatim from public/brand/mark-currentcolor.svg —
          never re-draw it here. */
      }
      <svg class="brand-mark" viewBox="0 0 160 160" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          fill-rule="evenodd"
          d="M30 0H130A30 30 0 0 1 160 30V130A30 30 0 0 1 130 160H30A30 30 0 0 1 0 130V30A30 30 0 0 1 30 0Z M37.38 116Q29.45 116 25.58 111.83Q21.71 107.67 21.71 101.22V76.21H7.82V64.8H16.84Q20.12 64.8 21.51 63.51Q22.9 62.22 22.9 58.75V46.74H36.39V64.8H56.34V76.21H36.39V104.59H56.34V116Z M131.5 106.67H130.8Q128.82 111.34 125.3 114.26Q121.78 117.19 115.62 117.19Q111.36 117.19 107.83 115.6Q104.31 114.02 101.78 110.74Q99.25 107.47 97.81 102.41Q96.37 97.35 96.37 90.4Q96.37 83.45 97.81 78.39Q99.25 73.33 101.78 70.06Q104.31 66.78 107.83 65.2Q111.36 63.61 115.62 63.61Q118.7 63.61 121.08 64.4Q123.46 65.2 125.3 66.59Q127.13 67.98 128.47 69.91Q129.81 71.84 130.8 74.13H131.5V42.57H146.18V116H131.5ZM121.97 105.78Q125.84 105.78 128.67 103.89Q131.5 102.01 131.5 97.94V82.86Q131.5 78.79 128.67 76.91Q125.84 75.02 121.97 75.02Q117.01 75.02 114.33 78.05Q111.65 81.07 111.65 86.43V94.37Q111.65 99.73 114.33 102.75Q117.01 105.78 121.97 105.78Z"
        ></path>
        <path
          fill="var(--accent)"
          d="M76.36 117.19Q70.8 117.19 68.37 114.76Q65.94 112.33 65.94 108.96V105.48Q65.94 102.11 68.37 99.68Q70.8 97.25 76.36 97.25Q81.91 97.25 84.34 99.68Q86.77 102.11 86.77 105.48V108.96Q86.77 112.33 84.34 114.76Q81.91 117.19 76.36 117.19Z"
        ></path>
      </svg>
      <span class="brand-name">twente<span class="brand-dot">.</span>dev</span>
    </a>

    <nav class="site-nav" aria-label={t('nav.menu')}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={routePath(item.key, locale)}
                aria-current={item.key === current ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <ThemeToggle locale={locale} />
      <LocaleSwitcher locale={locale} routeKey={current} slug={slug} />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-block-end: var(--border-width) solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  /* Scrolled state — set by the script below, so without JS the header simply
     stays at its resting height and nothing is lost. The lockup keeps the name
     at every size: twente.dev is a two-week-old brand, and a mark nobody has
     learnt yet is not a name. It just gets out of the way of the reading. */
  .site-header[data-scrolled] {
    --header-height: var(--header-height-compact);
    --brand-size: var(--text-sm);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-height);
    flex-wrap: wrap;
    transition: min-height var(--duration-base) var(--ease-out);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--fg);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    margin-inline-end: auto;
    /* One size drives the whole lockup: the mark is sized in em, so mark and
       wordmark shrink together and the spacing between them holds. */
    font-size: var(--brand-size, var(--text-base));
    transition: font-size var(--duration-base) var(--ease-out);
  }

  /* Optical, not mathematical: the badge reads heavier than the wordmark's
     cap height, so it is set slightly below 2em to sit level with it. */
  .brand-mark {
    width: 1.9em;
    height: 1.9em;
    flex: none;
  }

  /* The brand pack's wordmark: lowercase, mono, with the red connector dot.
     The dot is the header's one red signal. */
  .brand-name {
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .brand-dot {
    color: var(--accent);
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .site-nav a {
    color: var(--fg-muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    padding-block: var(--space-2);
    border-block-end: 2px solid transparent;
  }

  .site-nav a:hover {
    color: var(--fg);
  }

  .site-nav a[aria-current='page'] {
    color: var(--fg);
    border-block-end-color: var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (max-width: 47.99rem) {
    .header-inner {
      /* The nav wraps to its own row here, so the resting height is already
         exceeded — let the content set it and keep the compaction to the
         lockup alone. */
      min-height: 0;
      padding-block: var(--space-3);
    }

    .site-nav {
      order: 3;
      width: 100%;
    }

    .site-nav ul {
      gap: var(--space-3);
    }
  }
</style>

<script>
  // Progressive enhancement: the header is fully usable without this — it just
  // keeps its resting height. State comes from the scroll *position*, never the
  // direction, so a restored scroll offset on back-navigation renders the same
  // header as scrolling there by hand.
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  if (header) {
    let compact: boolean | null = null;

    const sync = (): void => {
      // A few pixels of tolerance: iOS rubber-banding and anchor scrolling both
      // land a hair off zero, and a header that flickers at the top of the page
      // is worse than one that compacts a moment late.
      const next = window.scrollY > 8;
      if (next === compact) return;
      compact = next;
      header.toggleAttribute('data-scrolled', next);
    };

    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>
