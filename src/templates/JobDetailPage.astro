---
import { LOCALE_TAGS } from '../i18n/config.ts';
import type { Locale } from '../i18n/config.ts';
import { formatDate, useTranslations } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import { summarize } from '../lib/content.ts';
import type { CompanyEntry, JobEntry } from '../lib/content.ts';
import { breadcrumbSchema, jobPostingSchema } from '../lib/jsonld.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';

interface Props {
  job: JobEntry;
  company: CompanyEntry;
  locale: Locale;
}

const { job, company, locale } = Astro.props;
const t = useTranslations(locale);

const workplaceLabel = {
  remote: t('jobs.remote'),
  hybrid: t('jobs.hybrid'),
  onsite: t('jobs.onsite'),
}[job.data.workplace];

const languageLabel =
  job.data.languageRequirement === 'dutch-required' ? t('jobs.dutchRequired') : t('jobs.englishOk');

// Schema enums are storage values; every rendered string goes through ui.ts.
const employmentLabel = t(`jobs.employment.${job.data.employmentType}`);
const seniorityLabel = t(`jobs.seniority.${job.data.seniority}`);

const salary = job.data.salary;

/**
 * Salary in the *reader's* number format. Hardcoded nl-NL rendered
 * "€5.200 / mnd" on the English page — which an en-GB reader parses as five
 * euros twenty — and "mnd" is a Dutch abbreviation ui.ts can't translate.
 */
const salaryLabel = salary
  ? `€${salary.min.toLocaleString(LOCALE_TAGS[locale])} – €${salary.max.toLocaleString(LOCALE_TAGS[locale])} ${salary.period === 'MONTH' ? t('jobs.salaryPerMonth') : t('jobs.salaryPerYear')}`
  : t('jobs.salaryUndisclosed');

const jsonLd = [
  jobPostingSchema(job, company, locale),
  breadcrumbSchema([
    { name: t('nav.home'), path: routePath('home', locale) },
    { name: t('jobs.title'), path: routePath('jobs', locale) },
    { name: job.data.title[locale], path: routePath('jobs', locale, job.id) },
  ]),
];
---

<BaseLayout
  locale={locale}
  routeKey="jobs"
  slug={job.id}
  title={`${job.data.title[locale]} — ${company.data.name}`}
  description={summarize(job.data.description[locale])}
  jsonLd={jsonLd}
>
  <div class="container detail">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={routePath('jobs', locale)}>{t('jobs.title')}</a>
    </nav>

    <header class="detail-header">
      <h1>{job.data.title[locale]}</h1>
      <p class="company">
        <a href={routePath('companies', locale, company.id)}>{company.data.name}</a>
      </p>

      <ul class="facts">
        {
          job.data.fixture && (
            <li>
              <Tag>{t('common.fixture')}</Tag>
            </li>
          )
        }
        <li><Tag>{job.data.city}</Tag></li>
        <li><Tag>{workplaceLabel}</Tag></li>
        <li><Tag>{employmentLabel}</Tag></li>
        <li><Tag>{seniorityLabel}</Tag></li>
        <li>
          <Tag variant={job.data.languageRequirement === 'english-ok' ? 'accent' : 'default'}>
            {languageLabel}
          </Tag>
        </li>
      </ul>
    </header>

    <div class="detail-body">
      <div class="prose">
        <p>{job.data.description[locale]}</p>

        <h2>{t('companies.stack')}</h2>
        <ul class="stack">
          {
            job.data.stack.map((tech) => (
              <li>
                <Tag>{tech}</Tag>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="sidebar">
        <dl>
          <dt>{t('jobs.salary')}</dt>
          <dd>{salaryLabel}</dd>

          <dt>{t('jobs.postedOn')}</dt>
          <dd>
            <time datetime={job.data.postedAt.toISOString()}>
              {formatDate(job.data.postedAt, locale)}
            </time>
          </dd>

          <dt>{t('jobs.closesOn')}</dt>
          <dd>
            <time datetime={job.data.validThrough.toISOString()}>
              {formatDate(job.data.validThrough, locale)}
            </time>
          </dd>
        </dl>

        <a class="button button--primary apply" href={job.data.applyUrl} rel="noopener"
          >{t('jobs.apply')} →</a
        >
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .detail {
    padding-block: var(--space-6);
  }

  .breadcrumb {
    font-size: var(--text-sm);
    margin-block-end: var(--space-4);
  }

  .detail-header {
    padding-block-end: var(--space-5);
    border-block-end: var(--border-width) solid var(--border);
  }

  .company {
    margin-block-start: var(--space-2);
    font-size: var(--text-lg);
  }

  .facts,
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-4);
  }

  .detail-body {
    display: grid;
    gap: var(--space-6);
    margin-block-start: var(--space-6);
  }

  @media (min-width: 56rem) {
    .detail-body {
      grid-template-columns: minmax(0, 1fr) 18rem;
      align-items: start;
    }
  }

  .sidebar {
    padding: var(--space-4);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
    position: sticky;
    top: 5rem;
  }

  dl {
    display: grid;
    gap: var(--space-1);
    margin: 0;
  }

  dt {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }

  dd {
    margin: 0 0 var(--space-3);
    font-weight: var(--weight-medium);
  }

  /* Visuals come from the shared .button--primary; only layout is local. */
  .apply {
    display: flex;
    width: 100%;
    margin-block-start: var(--space-2);
  }
</style>
