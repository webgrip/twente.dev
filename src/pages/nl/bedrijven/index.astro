---
import CompaniesPage from '../../../templates/CompaniesPage.astro';
import { routePath } from '../../../i18n/routes.ts';
import { formatDate } from '../../../i18n/utils.ts';
import { CONTACT_EMAIL, releaseName } from '../../../config/site.ts';
import { getCurrentRelease } from '../../../lib/content.ts';

const release = await getCurrentRelease();
---

<CompaniesPage
  locale="nl"
  title="Bedrijven"
  description="Je mensen laten gaan, of een zaal aanbieden voor een latere release."
>
  <p>
    <a href={routePath('release', 'nl', release.number)}>{releaseName(release.number)}</a> is op {
      formatDate(release.doors, 'nl')
    } bij {release.venueName} in {release.city}, dus de zaal is rond. Het meeste waar we bedrijven
    voor nodig hebben kost ook geen zaal: laat je mensen die avond gaan en reken het als werktijd.
    Voor de meeste bedrijven is dat de echte stap.
  </p>
  <p>
    Releases rouleren elke maand door de regio, dus voor later zoeken we steeds een nieuwe host: een
    ruimte waar
    {release.capacity} man in past, met eten en drinken erbij. Je naam staat dan op de editiepagina en
    in de zaal, en daar houdt het op. Een spreekplek zit er niet bij, ook niet voor de host, want dat
    loopt via de <a href={routePath('contribute', 'nl')}>open call</a>. De deelnemerslijst gaat naar
    niemand, en de rest van de afspraken staat op
    <a href={routePath('partners', 'nl')}>partners</a>.
  </p>
  <p>
    Mail <a href={`mailto:${CONTACT_EMAIL}?subject=Bedrijf%20wil%20bijdragen`}>{CONTACT_EMAIL}</a>,
    één alinea is genoeg.
  </p>
</CompaniesPage>
