---
import { getEntry } from 'astro:content';

import type { Locale } from '../i18n/config.ts';
import {
  formatDate,
  formatTime,
  formatTimeRange,
  formatWeekday,
  useTranslations,
} from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import {
  EDITION_001,
  EDITION_001_SPEAKERS,
  REGISTRATION_OPENS,
  REGISTRATION_URL,
  editionName,
} from '../config/site.ts';
import { eventSchema } from '../lib/jsonld.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import Tabs from '../components/Tabs.astro';

interface Props {
  locale: Locale;
}

interface Copy {
  metaTitle: string;
  metaDescription: string;
  intro: string[];
  factDate: string;
  factTime: string;
  factVenue: string;
  factLanguage: string;
  factCost: string;
  factCapacity: string;
  factsTitle: string;
  onThisPage: string;
  slotOpen: string;
  slotLabel: string;
  outcomes: [string, string, string];
  expectTitle: string;
  runOfShow: { time: string; item: string }[];
  whoTitle: string;
  whoBody: string;
  whoWelcome: string;
  isTitle: string;
  isList: string[];
  isNotTitle: string;
  isNotList: string[];
  speakersTitle: string;
  speakersTba: string;
  speakersTbaBody: string;
  speakersTbaCta: string;
  actionsTitle: string;
  tabReserve: string;
  tabUpdates: string;
  tabContribute: string;
  updatesTitle: string;
  updatesBody: string;
  registrationTitle: string;
  registrationOpens: string;
  registrationCta: string;
  registrationCalendarHint: string;
  registrationConsentNote: string;
  openCallTitle: string;
  openCallBody: string;
  openCallCta: string;
  practicalTitle: string;
  practical: { term: string; detail: string }[];
  safeguardsTitle: string;
  safeguards: string[];
  conductCta: string;
  partnersCta: string;
}

const { locale } = Astro.props;

const name = `${editionName(EDITION_001.number)}: ${EDITION_001.theme}`;
const time = formatTime;
const hours = formatTimeRange(EDITION_001.doors, EDITION_001.end);
const sentenceCase = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
const whenWhere = (loc: Locale) =>
  `${sentenceCase(formatWeekday(EDITION_001.doors, loc))} ${formatDate(EDITION_001.doors, loc)}, ${hours}, ${EDITION_001.city}`;

const COPY: Record<Locale, Copy> = {
  en: {
    metaTitle: name,
    metaDescription: `A practitioner-led evening for people who build technology in Twente. ${whenWhere('en')}. Free.`,
    intro: [
      'Twente builds technology with global reach, but the people and practical lessons behind it are still too hard to discover across companies and disciplines.',
      `${name} is a practitioner-led evening for everyone building technology in and around Twente: software, infrastructure, embedded systems, manufacturing, data, security, design, product, research and technical education. Two roughly half-hour talks by people who did the work themselves, and then an unhurried network hour to actually meet each other.`,
    ],
    factDate: 'Date',
    factTime: 'Time',
    factVenue: 'Venue',
    factLanguage: 'Language',
    factCost: 'Cost',
    factCapacity: 'Seats',
    factsTitle: 'The facts',
    onThisPage: 'On this page',
    slotOpen: 'Open',
    slotLabel: 'Slot',
    outcomes: ['One useful idea', 'One useful introduction', 'One reason to return'],
    expectTitle: 'The evening',
    runOfShow: [
      { time: time(EDITION_001.doors), item: 'Doors, food and first introductions' },
      { time: time(EDITION_001.start), item: 'Welcome' },
      {
        time: '19:00',
        item: 'Talk 1: something the speaker built, fixed or broke themselves',
      },
      { time: '19:30', item: 'Break' },
      { time: '19:45', item: 'Talk 2' },
      { time: '20:15', item: 'Networking' },
      { time: time(EDITION_001.end), item: 'Hard finish' },
    ],
    whoTitle: 'Who the room is for',
    whoBody:
      'People who build and apply technology across software, hardware, data, security, design, product, research and education, in and around Twente, at any career stage.',
    whoWelcome: 'First-timers and solo attendees are explicitly welcome.',
    isTitle: 'This is',
    isList: [
      'An independent community evening',
      'Practitioner talks',
      'Useful cross-disciplinary introductions',
      'Open contribution routes',
    ],
    isNotTitle: 'This is not',
    isNotList: [
      'A recruitment fair',
      'A vendor stage',
      'A replacement for existing meetups',
      'A closed executive network',
    ],
    speakersTitle: 'Who is speaking',
    speakersTba: 'Speakers to be announced',
    speakersTbaBody:
      'Both talk slots are still open. The call is running, speakers are picked editorially and no one can buy stage time, so names go up once they are confirmed and not a day earlier. What is already fixed: roughly half an hour each, about something the speaker built, fixed or broke themselves.',
    speakersTbaCta: 'Get an email when the programme is set',
    actionsTitle: 'Take part',
    tabReserve: 'Reserve',
    tabUpdates: 'Updates',
    tabContribute: 'Contribute',
    updatesTitle: 'Stay in the loop',
    updatesBody:
      'One email when the programme is announced, one when registration opens, and the field reports after that: an interview with someone who builds here, or one concrete lesson from a local system. No weekly bulletin about nothing having happened.',
    registrationTitle: 'Reserve a place',
    registrationOpens: 'Registration opens',
    registrationCta: 'Reserve a place',
    registrationCalendarHint: 'Subscribe to the calendar and the date is already in yours.',
    registrationConsentNote:
      'Event registration alone never adds you to the newsletter. That is a separate, explicit opt-in.',
    openCallTitle: 'Contribute a story, demo or introduction',
    openCallBody:
      'What should Twente know you are building, or learning the hard way? Send us one claim, one real example, decision or failure, what others can learn, and how you would involve the room. You do not need speaking experience; we help shape accepted contributions. We do not accept product pitches, paid speaking or confidential material.',
    openCallCta: 'See all ways to contribute',
    practicalTitle: 'Practical',
    practical: [
      {
        term: 'Access',
        detail:
          'Full access information (step-free route, seating, sound and a quiet space) is published on this page at least two weeks before the event.',
      },
      {
        term: 'Food',
        detail:
          'Food and non-alcoholic drinks are included and free. Dietary needs are asked at registration.',
      },
      {
        term: 'Photography',
        detail:
          'We take photos and record video for the archive. That runs on consent: tell us when you RSVP or at check-in and we will work around you. If you end up in something anyway, one message is enough to have it removed.',
      },
      {
        term: 'Recordings',
        detail:
          'Where we can, we record a talk for the archive. The speaker can have that recording taken down later; the text page for the talk stays up.',
      },
      {
        term: 'Cancellation',
        detail:
          'Plans change. Cancelling is one reply to your confirmation email, and your place goes to the next person on the waitlist.',
      },
    ],
    safeguardsTitle: 'Safeguards',
    safeguards: [
      'Sponsors receive no attendee data.',
      'No one can buy stage time. Speakers are selected editorially.',
      'The code of conduct applies, with a named contact at the event and a route that does not run through the venue.',
    ],
    conductCta: 'Read the code of conduct',
    partnersCta: 'Partner with twente.dev',
  },
  nl: {
    metaTitle: name,
    metaDescription: `Een practitioner-led avond voor iedereen die technologie bouwt in Twente. ${whenWhere('nl')}. Gratis.`,
    intro: [
      'Twente bouwt technologie met wereldwijde impact, maar de mensen en praktijklessen erachter zijn over bedrijven en disciplines heen nog te moeilijk te vinden.',
      `${name} is een practitioner-led avond voor iedereen die in en rondom Twente technologie bouwt: software, infrastructuur, embedded systems, maakindustrie, data, security, design, product, onderzoek en technisch onderwijs. Twee talks van ongeveer een halfuur, van mensen die het werk zelf deden, en daarna een ruim netwerkuur om elkaar echt te spreken.`,
    ],
    factDate: 'Datum',
    factTime: 'Tijd',
    factVenue: 'Locatie',
    factLanguage: 'Voertaal',
    factCost: 'Kosten',
    factCapacity: 'Plekken',
    factsTitle: 'De feiten',
    onThisPage: 'Op deze pagina',
    slotOpen: 'Open',
    slotLabel: 'Talkplek',
    outcomes: ['Eén nuttig idee', 'Eén nuttige kennismaking', 'Eén reden om terug te komen'],
    expectTitle: 'De avond',
    runOfShow: [
      { time: time(EDITION_001.doors), item: 'Inloop, eten en eerste kennismakingen' },
      { time: time(EDITION_001.start), item: 'Welkomstwoord' },
      {
        time: '19:00',
        item: 'Talk 1: iets dat de spreker zelf heeft gebouwd, gerepareerd of verprutst',
      },
      { time: '19:30', item: 'Pauze' },
      { time: '19:45', item: 'Talk 2' },
      { time: '20:15', item: 'Networking' },
      { time: time(EDITION_001.end), item: 'Strakke eindtijd' },
    ],
    whoTitle: 'Voor wie de avond is',
    whoBody:
      'Mensen die technologie bouwen en toepassen: software, hardware, data, security, design, product, onderzoek en onderwijs, in en rond Twente, in elke fase van je loopbaan.',
    whoWelcome: 'Nieuwkomers en mensen die alleen komen zijn nadrukkelijk welkom.',
    isTitle: 'Dit is het wél',
    isList: [
      'Een onafhankelijke community-avond',
      'Talks van makers zelf',
      'Nuttige kennismakingen over disciplines heen',
      'Open routes om bij te dragen',
    ],
    isNotTitle: 'Dit is het níet',
    isNotList: [
      'Een banenmarkt',
      'Een leverancierspodium',
      'Een vervanging van bestaande meetups',
      'Een besloten netwerk voor managers',
    ],
    speakersTitle: 'Wie er spreken',
    speakersTba: 'Sprekers worden nog aangekondigd',
    speakersTbaBody:
      'Beide talkplekken staan nog open. De open call loopt, sprekers kiezen we redactioneel en spreektijd is niet te koop, dus de namen komen erbij zodra ze bevestigd zijn en geen dag eerder. Wat wel al vaststaat: ongeveer een halfuur per verhaal, over iets wat de spreker zelf heeft gebouwd, gerepareerd of verprutst.',
    speakersTbaCta: 'Laat je mailen zodra het programma rond is',
    actionsTitle: 'Meedoen',
    tabReserve: 'Reserveren',
    tabUpdates: 'Updates',
    tabContribute: 'Bijdragen',
    updatesTitle: 'Blijf op de hoogte',
    updatesBody:
      'Eén mail zodra het programma bekend is, één zodra aanmelden opent, en daarna de field reports: een interview met iemand die hier bouwt, of één concrete les uit een lokaal systeem. Geen wekelijks bulletin over wat er niet gebeurd is.',
    registrationTitle: 'Reserveer een plek',
    registrationOpens: 'Aanmelden opent',
    registrationCta: 'Reserveer een plek',
    registrationCalendarHint: 'Abonneer op de agenda, dan staat de datum er alvast in.',
    registrationConsentNote:
      'Aanmelden voor het event zet je nooit op de nieuwsbrief. Dat is een aparte, expliciete opt-in.',
    openCallTitle: 'Draag een verhaal, demo of introductie bij',
    openCallBody:
      'Wat moet Twente weten over wat jij bouwt, of op de harde manier leert? Stuur ons één claim, één echt voorbeeld, besluit of mislukking, wat anderen ervan kunnen leren, en hoe je de zaal erbij betrekt. Spreekervaring is niet nodig; geaccepteerde bijdragen vormen we samen. Productpitches, betaalde spreektijd en vertrouwelijk materiaal accepteren we niet.',
    openCallCta: 'Bekijk alle manieren om bij te dragen',
    practicalTitle: 'Praktisch',
    practical: [
      {
        term: 'Toegankelijkheid',
        detail:
          'Volledige toegankelijkheidsinformatie (drempelvrije route, zitplaatsen, geluid en een rustige ruimte) verschijnt uiterlijk twee weken voor het event op deze pagina.',
      },
      {
        term: 'Eten',
        detail:
          'Eten en non-alcoholische drankjes zijn inbegrepen en gratis. Dieetwensen vragen we bij aanmelding.',
      },
      {
        term: 'Fotografie',
        detail:
          'We maken foto’s en video-opnames voor het archief. Dat gaat op toestemming: geef het aan bij je aanmelding of bij de check-in, dan houden we daar rekening mee. Sta je er achteraf toch op, dan is één bericht genoeg om het te laten verwijderen.',
      },
      {
        term: 'Opnames',
        detail:
          'Van een talk maken we waar het kan een opname voor het archief. De spreker kan die later laten verwijderen; de tekstpagina van de talk blijft staan.',
      },
      {
        term: 'Annuleren',
        detail:
          'Plannen veranderen. Afmelden is één antwoord op je bevestigingsmail, en je plek gaat naar de volgende op de wachtlijst.',
      },
    ],
    safeguardsTitle: 'Waarborgen',
    safeguards: [
      'Sponsors krijgen geen deelnemersdata.',
      'Spreektijd is niet te koop. Sprekers worden redactioneel geselecteerd.',
      'De gedragscode geldt, met een benoemd aanspreekpunt op het event en een route die niet via de gastheer loopt.',
    ],
    conductCta: 'Lees de gedragscode',
    partnersCta: 'Word partner van twente.dev',
  },
};

const c = COPY[locale];
const t = useTranslations(locale);
const entry = await getEntry('events', 'twente-dev-001-reconnect');
const jsonLd = entry ? [eventSchema(entry, locale)] : [];

const registrationOpen = REGISTRATION_URL !== null;
const sections = [
  { id: 'avond', label: c.expectTitle },
  { id: 'sprekers', label: c.speakersTitle },
  { id: 'voor-wie', label: c.whoTitle },
  { id: 'praktisch', label: c.practicalTitle },
  { id: 'meedoen', label: c.actionsTitle },
  { id: 'waarborgen', label: c.safeguardsTitle },
] as const;
const num = (id: (typeof sections)[number]['id']) =>
  String(sections.findIndex((s) => s.id === id) + 1).padStart(2, '0');
const opensIso = REGISTRATION_OPENS.toISOString();
const opensOn = formatDate(REGISTRATION_OPENS, locale);
const speakers = EDITION_001_SPEAKERS;
---

<BaseLayout
  locale={locale}
  routeKey="edition001"
  title={c.metaTitle}
  description={c.metaDescription}
  jsonLd={jsonLd}
>
  <div class="container edition">
    <div class="edition-grid">
      <header class="edition-hero grid-band">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a class="label-mono" href={routePath('events', locale)}>
            <span aria-hidden="true">←</span>
            {t('events.title')}
          </a>
        </nav>
        <p class="edition-lockup label-mono" aria-hidden="true">
          <span class="lockup-name">{editionName(EDITION_001.number)}</span>
          <span class="lockup-date">
            {String(EDITION_001.doors.getDate()).padStart(2, '0')}.{
              String(EDITION_001.doors.getMonth() + 1).padStart(2, '0')
            }
          </span>
          <span class="lockup-place">{EDITION_001.city} · {time(EDITION_001.doors)}</span>
        </p>
        <h1 class="text-display">{EDITION_001.theme}</h1>
        {c.intro.map((paragraph) => <p class="edition-intro">{paragraph}</p>)}

        <ul class="outcomes" role="list">
          {c.outcomes.map((outcome) => <li>{outcome}</li>)}
        </ul>
      </header>

      <aside class="edition-aside" aria-labelledby="edition-facts">
        <div class="edition-aside-inner">
          <h2 class="visually-hidden" id="edition-facts">{c.factsTitle}</h2>
          <dl class="facts">
            <div>
              <dt>{c.factDate}</dt>
              <dd>
                <time datetime={EDITION_001.doors.toISOString()}>
                  {formatDate(EDITION_001.doors, locale)}
                </time>
              </dd>
            </div>
            <div>
              <dt>{c.factTime}</dt>
              <dd>{hours}</dd>
            </div>
            <div>
              <dt>{c.factVenue}</dt>
              <dd>{EDITION_001.venue ?? `${EDITION_001.city}, ${t('edition.venueTba')}`}</dd>
            </div>
            <div>
              <dt>{c.factCapacity}</dt>
              <dd>{EDITION_001.capacity}</dd>
            </div>
            <div>
              <dt>{c.factCost}</dt>
              <dd>{t('edition.free')}</dd>
            </div>
            <div>
              <dt>{c.factLanguage}</dt>
              <dd class="fact-long">{t('edition.language')}</dd>
            </div>
          </dl>
          {
            registrationOpen && (
              <a class="button button--primary aside-cta" href={REGISTRATION_URL}>
                {c.registrationCta}
              </a>
            )
          }
          <nav class="aside-index" aria-label={c.onThisPage}>
            <ol role="list">
              {
                sections.map((section, index) => (
                  <li>
                    <a href={`#${section.id}`}>
                      <span class="label-mono aside-index-num">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span>{section.label}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </div>
      </aside>

      <div class="edition-main">
        <section class="edition-section reveal" id="avond">
          <p class="label-mono section-index">{num('avond')}</p>
          <h2>{c.expectTitle}</h2>
          <ol class="run-of-show" role="list">
            {
              c.runOfShow.map(({ time: at, item }) => (
                <li>
                  <span class="ros-time">{at}</span>
                  <span class="ros-item">{item}</span>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="edition-section reveal" id="sprekers">
          <p class="label-mono section-index">{num('sprekers')}</p>
          <h2>{c.speakersTitle}</h2>
          {
            speakers.length === 0 ? (
              <div class="speakers-tba">
                <ul class="slots" role="list">
                  {[1, 2].map((position) => (
                    <li>
                      <span class="label-mono slot-name">
                        {c.slotLabel} {position}
                      </span>
                      <span class="label-mono slot-state">{c.slotOpen}</span>
                    </li>
                  ))}
                </ul>
                <p class="speakers-badge label-mono">{c.speakersTba}</p>
                <p>{c.speakersTbaBody}</p>
                <p>
                  <a class="button" href="#updates">
                    {c.speakersTbaCta}
                  </a>
                </p>
              </div>
            ) : (
              <ul class="speakers" role="list">
                {speakers.map((speaker) => (
                  <li>
                    <p class="speaker-name">{speaker.name}</p>
                    {speaker.affiliation && (
                      <p class="speaker-affiliation">{speaker.affiliation}</p>
                    )}
                    {speaker.talk && <p class="speaker-talk">{speaker.talk[locale]}</p>}
                  </li>
                ))}
              </ul>
            )
          }
        </section>

        <section class="edition-section reveal" id="voor-wie">
          <p class="label-mono section-index">{num('voor-wie')}</p>
          <h2>{c.whoTitle}</h2>
          <p>{c.whoBody}</p>
          <p><strong>{c.whoWelcome}</strong></p>

          <div class="is-isnot">
            <div class="is-panel is-panel--yes">
              <h3 class="label-mono">{c.isTitle}</h3>
              <ul role="list">{c.isList.map((item) => <li>{item}</li>)}</ul>
            </div>
            <div class="is-panel is-panel--no">
              <h3 class="label-mono">{c.isNotTitle}</h3>
              <ul role="list">{c.isNotList.map((item) => <li>{item}</li>)}</ul>
            </div>
          </div>
        </section>

        <section class="edition-section reveal" id="praktisch">
          <p class="label-mono section-index">{num('praktisch')}</p>
          <h2>{c.practicalTitle}</h2>
          <dl class="practical">
            {
              c.practical.map(({ term, detail }) => (
                <div>
                  <dt>{term}</dt>
                  <dd>{detail}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="edition-section reveal" id="meedoen">
          <p class="label-mono section-index">{num('meedoen')}</p>
          <h2>{c.actionsTitle}</h2>
          <Tabs
            id="take-part"
            label={c.actionsTitle}
            tabs={[
              { id: 'reserve', label: c.tabReserve },
              { id: 'updates', label: c.tabUpdates },
              { id: 'contribute', label: c.tabContribute },
            ]}
          >
            <div id="reserve" data-tabs-panel>
              <h3 data-tabs-heading>{c.registrationTitle}</h3>
              {
                registrationOpen ? (
                  <p>
                    <a class="button button--primary" href={REGISTRATION_URL}>
                      {c.registrationCta}
                    </a>
                  </p>
                ) : (
                  <p class="registration-opens">
                    {c.registrationOpens}{' '}
                    <strong>
                      <time datetime={opensIso}>{opensOn}.</time>
                    </strong>
                    <a href={routePath('events', locale)}>{c.registrationCalendarHint}</a>
                  </p>
                )
              }
              <p class="consent-note">{c.registrationConsentNote}</p>
            </div>

            <div id="updates" data-tabs-panel>
              <h3 data-tabs-heading>{c.updatesTitle}</h3>
              <p>{c.updatesBody}</p>
              <NewsletterForm locale={locale} id="edition-updates" />
            </div>

            <div id="contribute" data-tabs-panel>
              <h3 data-tabs-heading>{c.openCallTitle}</h3>
              <p>{c.openCallBody}</p>
              <p>
                <a class="button" href={routePath('contribute', locale)}>
                  {c.openCallCta}
                </a>
              </p>
            </div>
          </Tabs>
        </section>

        <section class="edition-section reveal" id="waarborgen">
          <p class="label-mono section-index">{num('waarborgen')}</p>
          <h2>{c.safeguardsTitle}</h2>
          <ul class="safeguards">
            {c.safeguards.map((item) => <li>{item}</li>)}
          </ul>
          <p class="safeguard-links">
            <a href={routePath('conduct', locale)}>{c.conductCta}</a>
            <a href={routePath('partners', locale)}>{c.partnersCta}</a>
          </p>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .edition {
    padding-block-end: var(--space-8);
  }

  .breadcrumb {
    padding-block-end: var(--space-6);
  }

  .breadcrumb a {
    color: var(--fg-subtle);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent-strong);
  }

  .edition-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 64rem) {
    .edition-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      column-gap: var(--space-8);
      align-items: start;
    }

    .edition-hero {
      grid-column: 1;
      grid-row: 1;
    }

    .edition-aside {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: stretch;
      height: 100%;
    }

    .edition-main {
      grid-column: 1;
      grid-row: 2;
    }

    .edition-aside-inner {
      position: sticky;
      top: calc(var(--header-height-compact) + var(--space-5));
    }
  }

  .edition-hero {
    padding-block: var(--space-5) var(--space-7);
    border-block-end: var(--border-width) solid var(--border);
  }

  .edition-lockup {
    display: inline-grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    background: var(--signal-red);
    color: var(--accent-fg);
    border-radius: var(--radius-md);
    will-change: transform;
  }

  .lockup-name {
    font-weight: 700;
  }

