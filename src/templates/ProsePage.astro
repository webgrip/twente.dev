---
import type { Locale } from '../i18n/config.ts';
import type { RouteKey } from '../i18n/routes.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

/** Shell for hand-written prose pages (about, guidelines, privacy). */
interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
}

const { locale, routeKey, title, description } = Astro.props;
---

<BaseLayout locale={locale} routeKey={routeKey} title={title} description={description}>
  <div class="container">
    <PageHeader title={title} description={description} />
    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>
