---
import type { Locale } from '../i18n/config.ts';
import { otherLocales, useTranslations } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

/**
 * Static search (plan lever L8), one page per locale.
 *
 * Pagefind builds its index from `dist/` after `astro build` (see the
 * `build` script), so `/pagefind/*` only exists on the built site — under
 * `astro dev` the loader script 404s and the noscript-style fallback text
 * shows instead. The CSP additions that admit the same-origin script, its
 * stylesheet and its WASM live in astro.config.mjs.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Pagefind indexed the pages under their BCP 47 lang tags (nl-NL / en-GB);
// constraining results to the current locale keeps the two language trees
// from bleeding into each other's results. The page copy says so honestly
// ("in het Nederlands" / "in English") and cross-links the other locale's
// search — it used to promise "both languages", which this config never did.
const pagefindConfig = {
  element: '#pagefind-search',
  showSubResults: true,
  translations: {
    placeholder: t('search.placeholder'),
    zero_results: t('search.noResults'),
  },
};

const otherSearch = otherLocales(locale).map((target) => ({
  locale: target,
  href: routePath('search', target),
}));
---

<BaseLayout
  locale={locale}
  routeKey="search"
  title={t('search.label')}
  description={t('search.description')}
  noindex
>
  <div class="container">
    <PageHeader title={t('search.label')} description={t('search.description')} />

    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    {
      /* Config travels on a data attribute rather than through `define:vars`.
        `define:vars` forces `is:inline`, and Astro's CSP feature does not hash
        inline scripts — so the initialiser below was blocked by the page's own
        meta CSP and search silently never started. */
    }
    <div
      id="pagefind-search"
      data-search-config={JSON.stringify(pagefindConfig)}
      data-search-label={t('search.label')}
    >
      {
        /* Shown to no-JS visitors (and under `astro dev`, where /pagefind/*
          does not exist yet — dev builds surface the same honest fallback). */
      }
      <p class="search-fallback">{t('search.unavailable')}</p>
    </div>

    <p class="other-locale">
      {otherSearch.map((target) => <a href={target.href}>{t('search.otherLocale')} →</a>)}
    </p>

    {
      /* Deferred: 120KB of parser-blocking classic script held up first paint.
        Init waits for DOMContentLoaded, which also replaces the old
        `typeof PagefindUI` race guard. No programmatic focus: stealing focus
        into the input on load bypassed the skip link, header and h1. */
    }
    {
      /* Stays `is:inline`: /pagefind/pagefind-ui.js is written by pagefind AFTER
        astro build, so Astro must not try to resolve or bundle it. A `src`
        script needs no hash — `'self'` in the CSP admits it. */
    }
    <script is:inline defer src="/pagefind/pagefind-ui.js"></script>
    {
      /* NOT `is:inline`: Astro bundles this to /_astro/*.js, which `'self'`
        admits, so no hash is required and it cannot be blocked. */
    }
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // PagefindUI is a global from /pagefind/pagefind-ui.js, which does not exist
        // until pagefind runs after `astro build` — so there is nothing to import and
        // no types to resolve. Reading it off window keeps that honest and typechecked.
        const { PagefindUI } = window as unknown as {
          PagefindUI?: new (config: unknown) => unknown;
        };
        const mount = document.querySelector<HTMLElement>('#pagefind-search');
        if (!mount || !PagefindUI) return;
        document.querySelector('.search-fallback')?.remove();
        new PagefindUI(JSON.parse(mount.dataset.searchConfig ?? '{}'));

        // Pagefind gives its input a `title` and nothing else, so the only
        // accessible name a screen reader gets is one axe flags as
        // `label-title-only` — a title is a tooltip, not a label, and it is
        // invisible to touch and often to keyboard users too. Pagefind offers no
        // config hook for this, so name the input here once it exists. The
        // element is created synchronously by the constructor above, but guard
        // anyway: a future Pagefind could defer it, and a missing label is worth
        // failing quietly rather than throwing on a search page.
        const input = mount.querySelector<HTMLInputElement>('input[type="text"]');
        if (input) {
          input.setAttribute('aria-label', mount.dataset.searchLabel ?? 'Search');
          input.removeAttribute('title');
        }
      });
    </script>
  </div>
</BaseLayout>

<style>
  .search-fallback {
    color: var(--fg-muted);
  }

  .other-locale {
    margin-block-start: var(--space-4);
    font-size: var(--text-sm);
  }

  #pagefind-search {
    /* Map Pagefind's theming hooks onto the design tokens so results render
       in both themes without touching its stylesheet. --accent-strong, not
       --accent: Pagefind uses "primary" for result-link text, and raw signal
       red as text misses AA on dark surfaces. */
    --pagefind-ui-primary: var(--accent-strong);
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--bg-raised);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--bg-subtle);
    --pagefind-ui-border-width: var(--border-width);
    --pagefind-ui-border-radius: var(--radius-md);
    --pagefind-ui-font: var(--font-sans);
    max-width: var(--width-prose);
    min-height: 24rem;
  }
</style>
