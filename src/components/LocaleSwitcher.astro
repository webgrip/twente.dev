---
import { LOCALE_NAMES, LOCALE_TAGS } from '../i18n/config.ts';
import type { Locale } from '../i18n/config.ts';
import { otherLocales, slugFor } from '../i18n/utils.ts';
import type { SlugInput } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import type { RouteKey } from '../i18n/routes.ts';

/**
 * Links to the *equivalent* page in the other locale, not to its homepage.
 * Because route segments are localized, that target is resolved through
 * `routePath` rather than by rewriting the current URL.
 */
interface Props {
  locale: Locale;
  routeKey: RouteKey;
  slug?: SlugInput;
}

const { locale, routeKey, slug } = Astro.props;

/**
 * Accessible names are phrased in the *target* language (matching the link's
 * `lang` attribute) — the reader who needs "switch to English" is the one who
 * doesn't read Dutch. A sibling visually-hidden span wouldn't join the link's
 * accessible name; aria-label on the link itself does.
 */
const SWITCH_LABELS: Record<Locale, string> = {
  nl: 'Overschakelen naar Nederlands',
  en: 'Switch to English',
};

/**
 * When the current page has no counterpart in the target locale — an article
 * written only in Dutch, say — the switcher falls back to that section's index
 * rather than linking to a URL that was never built.
 */
const targets = otherLocales(locale).map((target) => {
  const targetSlug = slugFor(slug, target);
  const missing = slug !== undefined && targetSlug === undefined;
  return {
    locale: target,
    href: routePath(routeKey, target, targetSlug),
    missing,
  };
});
---

<div class="locale-switcher">
  {
    targets.map((target) => (
      <a
        href={target.href}
        hreflang={LOCALE_TAGS[target.locale]}
        lang={target.locale}
        aria-label={SWITCH_LABELS[target.locale]}
        rel={target.missing ? 'nofollow' : undefined}
      >
        <abbr title={LOCALE_NAMES[target.locale]}>{target.locale.toUpperCase()}</abbr>
      </a>
    ))
  }
</div>

<style>
  .locale-switcher {
    display: inline-flex;
    gap: var(--space-1);
  }

  .locale-switcher a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    min-height: 2.25rem;
    padding-inline: var(--space-2);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    color: var(--fg-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    text-decoration: none;
  }

  .locale-switcher a:hover {
    color: var(--fg);
    border-color: var(--border-strong);
    background: var(--bg-subtle);
  }

  abbr {
    text-decoration: none;
  }
</style>
