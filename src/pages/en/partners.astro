---
import ProsePage from '../../templates/ProsePage.astro';
import { CONTACT_EMAIL } from '../../config/site.ts';
---

<ProsePage
  locale="en"
  routeKey="partners"
  title="Partners"
  description="How organisations support twente.dev. We are still working out the partner model — early conversations welcome."
>
  <p>
    Organisations will soon be able to support twente.dev as partners: food, venues and production,
    in return for visible credit — never for attendee data, stage time or editorial influence. We
    are working out the full partner model right now, and it will appear here.
  </p>
  <p>
    Interested in supporting already? Email
    <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> — being early has its advantages.
  </p>
</ProsePage>
