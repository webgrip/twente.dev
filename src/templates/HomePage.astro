---
import type { Locale } from '../i18n/config.ts';
import { formatDate, formatTimeRange, useTranslations } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import { getCurrentRelease, getPosts, getUpcomingEvents, isOwnRelease } from '../lib/content.ts';
import { REGISTRATION_OPENS, REGISTRATION_URL, releaseName } from '../config/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import PostCard from '../components/PostCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

const release = await getCurrentRelease();

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const [events, posts] = await Promise.all([getUpcomingEvents(), getPosts(locale)]);

const otherEvents = events.filter((event) => !isOwnRelease(event));

const releaseTitle = `${releaseName(release.number)}: ${release.theme}`;
const motto = `twente.dev // ${t('site.tagline').toLowerCase()}`;

const hours = formatTimeRange(release.doors, release.end);

const bands = [
  { id: 'agenda', index: '01', title: t('home.does.calendar.title') },
  { id: 'avond', index: '02', title: t('home.does.evening.title') },
  { id: 'archief', index: '03', title: t('home.does.archive.title') },
] as const;
---

<BaseLayout
  locale={locale}
  routeKey="home"
  title={t('site.name')}
  description={t('site.description')}
>
  <div class="hero grid-band">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-lede">
          <p class="label-mono hero-motto" lang="en">{motto}</p>
          <h1 class="text-display">{t('home.hero.title')}</h1>
          <p class="hero-subtitle">{t('home.hero.subtitle')}</p>
          <div class="hero-actions">
            <a class="button button--primary" href={routePath('release', locale, release.number)}>
              {REGISTRATION_URL ? t('home.hero.ctaReserve') : t('release.details')}
            </a>
            <a class="button" href={routePath('contribute', locale)}>
              {t('home.hero.ctaContribute')}
            </a>
          </div>
        </div>

        <aside class="newsletter" aria-labelledby="newsletter-title">
          <h2 id="newsletter-title">{t('home.newsletter.title')}</h2>
          <p>{t('home.newsletter.body')}</p>
          <NewsletterForm locale={locale} id="home" submit="outline" />
          <a class="newsletter-write" href={routePath('contribute', locale)}>
            {t('home.newsletter.write')} →
          </a>
        </aside>
      </div>

      <ol class="hero-index" role="list">
        {bands.map((band) => <li>
          <a href={`#${band.id}`}>
            <span class="label-mono hero-index-num">{band.index}</span>
            <span class="hero-index-title">{band.title}</span>
          </a>
        </li>)}
      </ol>
    </div>
  </div>

  <div class="container">
    <section class="feature" aria-labelledby="feature-title">
      <p class="label-mono feature-kicker">{t('home.next.kicker')}</p>
      <div class="feature-grid">
        <div class="feature-main">
          <h2 id="feature-title">{releaseTitle}</h2>
          <p class="feature-when">
            <time datetime={release.doors.toISOString()}>
              {formatDate(release.doors, locale)}
            </time>
            {` · ${hours}`}
          </p>
          <p class="feature-where">
            {release.venue ?? t('release.venueTba')}{' · '}{release.city}{' · '}{t('release.free')}
          </p>
          <p class="feature-language">{t('release.language')}</p>
        </div>

        <div class="feature-panel">
          {!REGISTRATION_URL && <p class="feature-registration">
            <span class="label-mono feature-registration-label">
              {t('release.registrationOpens')}
            </span>
            <time class="feature-registration-date" datetime={REGISTRATION_OPENS.toISOString()}>
              {formatDate(REGISTRATION_OPENS, locale)}
            </time>
          </p>}
          <a class="button button--primary" href={routePath('release', locale, release.number)}>
            {REGISTRATION_URL ? t('home.hero.ctaReserve') : t('home.next.cta')}
          </a>
        </div>
      </div>
    </section>

    <section class="intro" aria-labelledby="intro-title">
      <div class="band-head">
        <h2 id="intro-title">{t('home.what.title')}</h2>
        <p class="band-intro">{t('home.what.body')}</p>
      </div>
    </section>

    <section class="band" id="agenda" aria-labelledby="agenda-title">
      <p class="label-mono band-index">{bands[0].index}</p>
      <div class="band-head">
        <h2 id="agenda-title">{t('home.does.calendar.title')}</h2>
        <p class="band-intro">{t('home.does.calendar.body')}</p>
      </div>
      <div class="band-content">
        {otherEvents.length === 0 ? (
          <p class="empty">
            {t('home.agenda.empty')}{' '}
            <a href={routePath('contribute', locale)}>{t('events.emptyCta')}</a>
          </p>
        ) : (
          <div class="event-grid">
            {otherEvents.slice(0, 4).map((event) => (
              <EventCard event={event} locale={locale} />
            ))}
          </div>
        )}
        <p class="band-link">
          <a href={routePath('events', locale)}>{t('events.subscribe')} →</a>
        </p>
      </div>
    </section>

    <section class="band" id="avond" aria-labelledby="avond-title">
      <p class="label-mono band-index">{bands[1].index}</p>
      <div class="band-head">
        <h2 id="avond-title">{t('home.does.evening.title')}</h2>
        <p class="band-intro">{t('home.does.evening.body')}</p>
      </div>
      <div class="band-content">
        <div class="note">
          <h3>{t('home.community.title')}</h3>
          <p>{t('home.community.body')}</p>
          <p class="band-link">
            <a href={routePath('communities', locale)}>{t('common.viewAll')} →</a>
          </p>
        </div>
      </div>
    </section>

    <section class="band" id="archief" aria-labelledby="archief-title">
      <p class="label-mono band-index">{bands[2].index}</p>
      <div class="band-head">
        <h2 id="archief-title">{t('home.does.archive.title')}</h2>
        <p class="band-intro">{t('home.does.archive.body')}</p>
      </div>
      <div class="band-content">
        {posts.length === 0 ? (
          <p class="empty">
            {t('blog.empty')} <a href={routePath('contribute', locale)}>{t('blog.emptyCta')}</a>
          </p>
        ) : (
          <div class="post-grid">
            {posts.slice(0, 4).map((post) => (
              <PostCard post={post} locale={locale} />
            ))}
          </div>
        )}
        <p class="band-link">
          <a href={routePath('blog', locale)}>{t('home.posts.all')} →</a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: stretch;
    padding-block: var(--space-8);
    border-block-end: var(--border-width) solid var(--border);
  }

  .hero > .container {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 48rem) {
    .hero {
      min-height: calc(100svh - var(--header-height));
    }
  }

  .hero::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 6px;
    background: var(--accent);
  }

  .hero-motto {
    color: var(--fg-subtle);
  }

  .hero h1 {
    margin-block-start: var(--space-4);
    max-width: 22ch;
  }

  .hero-subtitle {
    margin-block-start: var(--space-5);
    font-size: var(--text-lg);
    color: var(--fg-muted);
    max-width: 46ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  .hero-index {
    display: grid;
    gap: 0;
    list-style: none;
    padding: 0;
    margin: var(--space-7) 0 0;
    border-block-start: var(--border-width) solid var(--border-strong);
  }

  .hero-index a {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-3);
    color: var(--fg);
    text-decoration: none;
    border-block-end: var(--border-width) solid var(--border);
  }

  .hero-index a:hover .hero-index-title {
    color: var(--accent-strong);
  }

  .hero-index-num {
    color: var(--fg-subtle);
  }

  .hero-index-title {
    font-weight: 550;
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (min-width: 48rem) {
    .hero-grid {
      margin-block-end: var(--space-7);
    }

    .hero-index {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
      margin-block-start: auto;
    }

    .hero-index a {
      border-block-end: 0;
    }
  }

  .feature {
    position: relative;
    margin-block-start: var(--space-7);
    padding: var(--space-5);
    border: var(--border-width) solid var(--border-strong);
    border-inline-start: 3px solid var(--accent);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
  }

  @media (min-width: 48rem) {
    .feature {
      padding: var(--space-5) var(--space-6);
    }
  }

  .feature-kicker {
    color: var(--fg-subtle);
    padding-block-end: var(--space-4);
    border-block-end: var(--border-width) solid var(--border);
  }

  .feature-grid {
    display: grid;
    gap: var(--space-5);
    padding-block-start: var(--space-5);
  }

  @media (min-width: 64rem) {
    .feature-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      align-items: start;
      gap: var(--space-6);
    }

    .feature-panel {
      align-self: stretch;
      padding-block-start: 0;
      border-block-start: 0;
      padding-inline-start: var(--space-6);
      border-inline-start: var(--border-width) solid var(--border);
    }
  }

  .feature-when {
    margin-block-start: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    font-variant-numeric: tabular-nums;
  }

  .feature-where {
    margin-block-start: var(--space-1);
    color: var(--fg-muted);
  }

  .feature-language {
    margin-block-start: var(--space-3);
    color: var(--fg-subtle);
    font-size: var(--text-sm);
  }

  .feature-panel {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    align-content: start;
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--border);
  }

  .feature-registration {
    display: grid;
    gap: var(--space-1);
  }

  .feature-registration-label {
    color: var(--fg-subtle);
  }

  .feature-registration-date {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  .intro,
  .band {
    margin-block-start: var(--space-8);
  }

  .band-index {
    color: var(--fg-subtle);
    padding-block-end: var(--space-3);
    border-block-start: var(--border-width) solid var(--border-strong);
    padding-block-start: var(--space-3);
  }

  .band-head {
    display: grid;
    gap: var(--space-3);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .band-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: var(--space-7);
    }
  }

  .band-head h2 {
    font-size: var(--text-2xl);
    max-width: 18ch;
  }

  .band-intro {
    color: var(--fg-muted);
    font-size: var(--text-lg);
    max-width: 52ch;
  }

  .band-content {
    margin-block-start: var(--space-6);
  }

  .band-link {
    margin-block-start: var(--space-4);
    font-weight: 550;
  }

  .band-link a {
    text-decoration: none;
  }

  .band-link a:hover {
    text-decoration: underline;
  }

  .event-grid,
  .post-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .event-grid,
    .post-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-6);
    }
  }

  .note {
    padding: var(--space-5);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-subtle);
  }

  .note p {
    color: var(--fg-muted);
    margin-block-start: var(--space-3);
    max-width: var(--width-prose);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 23rem);
      gap: var(--space-8);
      align-items: start;
    }
  }

  .newsletter {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: var(--space-5);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
  }

  .newsletter h2 {
    font-size: var(--text-xl);
  }

  .newsletter p {
    color: var(--fg-muted);
  }

  .newsletter :global(.subscribe) {
    width: 100%;
  }

  .newsletter-write {
    font-size: var(--text-sm);
    font-weight: 550;
  }

  .empty {
    color: var(--fg-muted);
  }
</style>
