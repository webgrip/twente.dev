---
import ProsePage from '../../templates/ProsePage.astro';
import { CONTACT_EMAIL } from '../../config/site.ts';
---

<ProsePage
  locale="nl"
  routeKey="partners"
  title="Partners"
  description="Hoe organisaties twente.dev steunen. Het partnermodel werken we nog uit — praat vast met ons mee."
>
  <p>
    Organisaties kunnen twente.dev straks steunen als partner: eten, locaties en productie, in ruil
    voor zichtbare vermelding — nooit voor deelnemersdata, spreektijd of redactionele invloed. Het
    volledige partnermodel werken we op dit moment uit en verschijnt hier.
  </p>
  <p>
    Nu al interesse om te steunen? Mail
    <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> — er vroeg bij zijn heeft zo z'n voordelen.
  </p>
</ProsePage>
