---
import type { Locale } from '../i18n/config.ts';
import { otherLocales, useTranslations } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const searchTranslations = {
  placeholder: t('search.placeholder'),
  zero_results: t('search.noResults'),
};

const otherSearch = otherLocales(locale).map((target) => ({
  locale: target,
  href: routePath('search', target),
}));
---

<BaseLayout
  locale={locale}
  routeKey="search"
  title={t('search.label')}
  description={t('search.description')}
  noindex
>
  <div class="container">
    <PageHeader title={t('search.label')} description={t('search.description')} />

    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
    <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
    <div
      id="pagefind-search"
      lang={locale}
      data-search-translations={JSON.stringify(searchTranslations)}
    >
      <pagefind-input placeholder={t('search.placeholder')}></pagefind-input>
      <pagefind-summary></pagefind-summary>
      <pagefind-results show-sub-results></pagefind-results>
      <noscript><p class="search-fallback">{t('search.unavailable')}</p></noscript>
    </div>

    <p class="other-locale">
      {otherSearch.map((target) => <a href={target.href}>{t('search.otherLocale')} →</a>)}
    </p>

    <script>
      type PagefindInstance = { setTranslations: (translations: Record<string, string>) => void };
      type PagefindComponents = {
        getInstanceManager: () => { getInstance: (name: string) => PagefindInstance | undefined };
      };

      const mount = document.querySelector<HTMLElement>('#pagefind-search');
      const components = (window as unknown as { PagefindComponents?: PagefindComponents })
        .PagefindComponents;
      const instance = components?.getInstanceManager().getInstance('default');
      if (mount && instance) {
        instance.setTranslations(JSON.parse(mount.dataset.searchTranslations ?? '{}'));
      }
    </script>
  </div>
</BaseLayout>

<style>
  .search-fallback {
    color: var(--fg-muted);
  }

  .other-locale {
    margin-block-start: var(--space-4);
    font-size: var(--text-sm);
  }

  #pagefind-search {
    --pf-text: var(--fg);
    --pf-background: var(--bg-raised);
    --pf-border: var(--border);
    --pf-border-radius: var(--radius-md);
    --pf-input-height: 2.75rem;
    --pf-input-font-size: var(--text-base);
    --pf-result-title-font-size: var(--text-base);
    --pf-result-excerpt-font-size: var(--text-sm);
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-prose);
    min-height: 24rem;
  }
</style>
