---
import ProsePage from '../../templates/ProsePage.astro';
import Confetti from '../../components/Confetti.astro';
import { CONTACT_EMAIL } from '../../config/site.ts';
import { routePath } from '../../i18n/routes.ts';
---

<ProsePage
  locale="nl"
  routeKey="confirmed"
  noindex
  title="Je staat erop"
  description="Je aanmelding is bevestigd. Hier staat wat je krijgt."
>
  <Confetti />

  <p class="lede"><strong>Bevestigd.</strong> Verder hoef je niets te doen.</p>

  <p>Wat er in je inbox komt:</p>

  <ul>
    <li><strong>Field reports</strong>, interviews met mensen die hier iets bouwen.</li>
    <li>
      <strong>Release notes</strong> binnen tien werkdagen na een avond: de slides, de foto's en wat er
      níet werkte.
    </li>
    <li><strong>Upstream</strong>, wat er in de regio speelt buiten ons om.</li>
    <li>Een open call als er nog een talkplek vrij is.</li>
  </ul>

  <p>
    Geen vaste cadans. Er gaat een mail uit als er iets te melden is. Antwoorden mag, er zit een
    mens aan de andere kant. Afmelden kost één klik.
  </p>

  <p>
    Ondertussen: <a href={routePath('blog', 'nl')}>het archief</a>, de
    <a href={routePath('events', 'nl')}>agenda</a>, of <a href={routePath('contribute', 'nl')}
      >waar we hulp bij kunnen gebruiken</a
    >. Klopt er iets niet? Mail <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
  </p>
</ProsePage>

<style>
  .lede {
    font-size: var(--text-lg);
  }
</style>
