---
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/utils.ts';
import type { ResolvedRelease } from '../lib/release.ts';

interface Props {
  locale: Locale;
  release: ResolvedRelease;
}

const { locale, release } = Astro.props;
const t = useTranslations(locale);

const maps = import.meta.glob('../assets/maps/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const slug = release.venueMap;
const svg = slug ? maps[`../assets/maps/${slug}.svg`] : undefined;
if (slug && !svg) {
  throw new Error(`venue.map "${slug}" has no file in src/assets/maps/`);
}

const destination = [release.venueName, release.venuePostalAddress, release.city]
  .filter(Boolean)
  .join(', ');
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(destination)}`;
const geo = release.venueGeo;
const osmUrl = geo
  ? `https://www.openstreetmap.org/?mlat=${geo.lat}&mlon=${geo.lon}#map=17/${geo.lat}/${geo.lon}`
  : `https://www.openstreetmap.org/search?query=${encodeURIComponent(destination)}`;
const labelledSvg = svg?.replace('<svg ', `<svg role="img" aria-label="${t('venue.mapAlt')}" `);
const directions = release.venueDirections?.[locale];
---

<figure class="venue-map">
  {labelledSvg && <div class="venue-map-canvas" set:html={labelledSvg} />}
  <figcaption>
    <p class="venue-map-address">
      <strong>{release.venueName ?? release.city}</strong>
      {
        release.venuePostalAddress && (
          <span class="venue-map-street">
            {release.venuePostalAddress}, {release.city}
          </span>
        )
      }
    </p>
    {directions && <p class="venue-map-directions">{directions}</p>}
    <p class="venue-map-links">
      <a href={directionsUrl} rel="noopener">{t('venue.directions')} →</a>
      <a href={osmUrl} rel="noopener">{t('venue.openstreetmap')} →</a>
    </p>
    {labelledSvg && <p class="venue-map-credit">{t('venue.mapCredit')}</p>}
  </figcaption>
</figure>

<style>
  .venue-map {
    margin: 0;
  }

  .venue-map-canvas {
    overflow: hidden;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
  }

  .venue-map-canvas :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .venue-map-canvas :global(.map-ground) {
    fill: var(--bg-subtle);
  }

  .venue-map-canvas :global(.map-water) {
    fill: var(--bg-inset);
  }

  .venue-map-canvas :global(.map-water-line) {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }

  .venue-map-canvas :global(.map-road) {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .venue-map-canvas :global(.map-road--minor) {
    stroke: var(--border);
    stroke-width: 1;
  }

  .venue-map-canvas :global(.map-road--medium) {
    stroke: var(--border-strong);
    stroke-width: 1.6;
  }

  .venue-map-canvas :global(.map-road--major) {
    stroke: var(--fg-subtle);
    stroke-width: 2.6;
  }

  .venue-map-canvas :global(.map-rail) {
    fill: none;
    stroke: var(--fg-muted);
    stroke-width: 2.2;
  }

  .venue-map-canvas :global(.map-rail-ties) {
    fill: none;
    stroke: var(--bg-subtle);
    stroke-width: 1.2;
    stroke-dasharray: 5 5;
  }

  .venue-map-canvas :global(.map-venue-building) {
    fill: var(--accent-subtle);
    stroke: var(--accent);
    stroke-width: 1;
  }

  .venue-map-canvas :global(.map-station rect) {
    fill: var(--fg);
  }

  .venue-map-canvas :global(.map-venue-ring) {
    fill: var(--accent);
    fill-opacity: 0.18;
  }

  .venue-map-canvas :global(.map-venue-dot) {
    fill: var(--accent);
    stroke: var(--bg-raised);
    stroke-width: 2;
  }

  .venue-map-canvas :global(.map-label) {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--fg);
    paint-order: stroke;
    stroke: var(--bg-subtle);
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .venue-map-canvas :global(.map-label--venue) {
    font-weight: 700;
    fill: var(--accent-strong);
  }

  .venue-map-canvas :global(.map-scale path) {
    fill: none;
    stroke: var(--fg-subtle);
    stroke-width: 1.5;
  }

  figcaption {
    margin-block-start: var(--space-4);
    display: grid;
    gap: var(--space-2);
  }

  .venue-map-address {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
  }

  .venue-map-street {
    color: var(--fg-muted);
  }

  .venue-map-directions {
    color: var(--fg-muted);
  }

  .venue-map-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-weight: 550;
  }

  .venue-map-credit {
    color: var(--fg-subtle);
    font-size: var(--text-xs);
  }
</style>
