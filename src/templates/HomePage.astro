---
import type { Locale } from '../i18n/config.ts';
import { formatDate, useTranslations } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import { getPosts, getUpcomingEvents } from '../lib/content.ts';
import {
  CONTACT_EMAIL,
  EDITION_001,
  NEWSLETTER_URL,
  REGISTRATION_OPENS,
  REGISTRATION_URL,
  editionName,
} from '../config/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import PostCard from '../components/PostCard.astro';

/**
 * The playbook's contract for this page: promise, explanation, next event,
 * proof, partners, contribution CTA — and a new visitor reaches RSVP or
 * contribute in two clicks.
 *
 * Visual grammar comes from the brand pack's social banner: warm paper, the
 * thread grid, a red edge, mono wayfinding lines, one dominant statement.
 *
 * The page is organised as one numbered sequence — the hero's index strip and
 * the three bands share the numbers 01–03. It used to carry two competing
 * sequences (an outcomes trio 01–03 inside the hero, then sections numbered
 * 01–03 again below it), which read as a numbering bug rather than a rhythm.
 * The flagship also appeared twice: once as a facts card and again as the only
 * card in "upcoming events", so a full-width feature covers it once and the
 * agenda band lists what else is on.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const [events, posts] = await Promise.all([getUpcomingEvents(), getPosts(locale)]);

/**
 * The flagship has its own feature block above, so the agenda band lists the
 * rest. Matched on the canonical route rather than on `attribution: own`: it is
 * the field that says "this entry's home is a bespoke page", which is exactly
 * the entry the feature is already rendering.
 */
const otherEvents = events.filter((event) => event.data.canonicalRoute !== 'edition001');

const edition = `${editionName(EDITION_001.number)} — ${EDITION_001.theme}`;
const motto = `twente.dev // ${t('site.tagline').toLowerCase()}`;

/** Hero index strip and the bands below it are the same three things. */
const bands = [
  { id: 'agenda', index: '01', title: t('home.does.calendar.title') },
  { id: 'avond', index: '02', title: t('home.does.evening.title') },
  { id: 'archief', index: '03', title: t('home.does.archive.title') },
] as const;
---

<BaseLayout
  locale={locale}
  routeKey="home"
  title={t('site.name')}
  description={t('site.description')}
>
  <div class="hero thread-grid thread-grid--bleed">
    <div class="container">
      {
        /* The motto is deliberate English branding on both locales; the lang
          attribute keeps screen readers from reading it with Dutch rules
          (SC 3.1.2 Language of Parts). */
      }
      <p class="label-mono hero-motto" lang="en">{motto}</p>
      <h1 class="text-display">{t('home.hero.title')}</h1>
      <p class="hero-subtitle">{t('home.hero.subtitle')}</p>
      <div class="hero-actions">
        {
          /* Until registration opens the button must not promise "reserve a
             place" — the very first click on the site's most prominent CTA
             would end in "you can't do this yet". */
        }
        <a class="button button--primary" href={routePath('edition001', locale)}>
          {REGISTRATION_URL ? t('home.hero.ctaReserve') : t('edition.details')}
        </a>
        <a class="button" href={routePath('contribute', locale)}>
          {t('home.hero.ctaContribute')}
        </a>
      </div>

      {
        /* Sits on the fold as the cue that there is more below, and doubles as
           the page's contents: each entry jumps to the band that delivers it. */
      }
      <ol class="hero-index" role="list">
        {
          bands.map((band) => (
            <li>
              <a href={`#${band.id}`}>
                <span class="label-mono hero-index-num">{band.index}</span>
                <span class="hero-index-title">{band.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <div class="container">
    {/* The next edition, once, at full width. */}
    <section class="feature" aria-labelledby="feature-title">
      <p class="label-mono feature-kicker">{t('home.next.kicker')}</p>
      <div class="feature-grid">
        <div class="feature-main">
          <h2 id="feature-title">{edition}</h2>
          {
            /* Separators are explicit strings: Astro collapses the whitespace
              around expression boundaries, which rendered "Locatie volgt ·Gratis". */
          }
          <p class="feature-when">
            <time datetime={EDITION_001.doors.toISOString()}>
              {formatDate(EDITION_001.doors, locale)}
            </time>
            {' · 18:00–21:30'}
          </p>
          <p class="feature-where">
            {EDITION_001.venue ?? t('edition.venueTba')}{' · '}{EDITION_001.city}{' · '}{
              t('edition.free')
            }
          </p>
          <p class="feature-language">{t('edition.language')}</p>
        </div>

        <div class="feature-panel">
          <p class="feature-registration">
            <span class="label-mono feature-registration-label">
              {t('edition.registrationOpens')}
            </span>
            <time class="feature-registration-date" datetime={REGISTRATION_OPENS.toISOString()}>
              {formatDate(REGISTRATION_OPENS, locale)}
            </time>
          </p>
          {
            /* The hero already carries the edition's full name one screen up,
               and the heading beside this button repeats it — so the button
               says what it does. The long label also wrapped mid-word inside
               the panel, which is what a 25-character mono uppercase CTA does
               in a column narrower than itself. */
          }
          <a class="button button--primary" href={routePath('edition001', locale)}>
            {REGISTRATION_URL ? t('home.hero.ctaReserve') : t('home.next.cta')}
          </a>
        </div>
      </div>
    </section>

    {
      /* Kept as its own section rather than folded into the hero: on a site
         this young "what is this" is a question a first-time visitor actually
         asks, and the answer should not depend on reading three bands first. */
    }
    <section class="intro" aria-labelledby="intro-title">
      <div class="band-head">
        <h2 id="intro-title">{t('home.what.title')}</h2>
        <p class="band-intro">{t('home.what.body')}</p>
      </div>
    </section>

    <section class="band" id="agenda" aria-labelledby="agenda-title">
      <p class="label-mono band-index">{bands[0].index}</p>
      <div class="band-head">
        <h2 id="agenda-title">{t('home.does.calendar.title')}</h2>
        <p class="band-intro">{t('home.does.calendar.body')}</p>
      </div>
      <div class="band-content">
        {
          otherEvents.length === 0 ? (
            <p class="empty">
              {t('home.agenda.empty')}{' '}
              <a href={routePath('contribute', locale)}>{t('events.emptyCta')}</a>
            </p>
          ) : (
            <div class="event-grid">
              {otherEvents.slice(0, 4).map((event) => (
                <EventCard event={event} locale={locale} />
              ))}
            </div>
          )
        }
        <p class="band-link">
          <a href={routePath('events', locale)}>{t('events.subscribe')} →</a>
        </p>
      </div>
    </section>

    <section class="band" id="avond" aria-labelledby="avond-title">
      <p class="label-mono band-index">{bands[1].index}</p>
      <div class="band-head">
        <h2 id="avond-title">{t('home.does.evening.title')}</h2>
        <p class="band-intro">{t('home.does.evening.body')}</p>
      </div>
      <div class="band-content">
        {
          /* The non-displacement promise, stated on the page that could most
             easily be read as competing with the region's other meetups. */
        }
        <div class="note">
          <h3>{t('home.community.title')}</h3>
          <p>{t('home.community.body')}</p>
          <p class="band-link">
            <a href={routePath('communities', locale)}>{t('common.viewAll')} →</a>
          </p>
        </div>
      </div>
    </section>

    <section class="band" id="archief" aria-labelledby="archief-title">
      <p class="label-mono band-index">{bands[2].index}</p>
      <div class="band-head">
        <h2 id="archief-title">{t('home.does.archive.title')}</h2>
        <p class="band-intro">{t('home.does.archive.body')}</p>
      </div>
      <div class="band-content">
        {
          posts.length === 0 ? (
            <p class="empty">
              {t('blog.empty')} <a href={routePath('contribute', locale)}>{t('blog.emptyCta')}</a>
            </p>
          ) : (
            <div class="post-grid">
              {posts.slice(0, 4).map((post) => (
                <PostCard post={post} locale={locale} />
              ))}
            </div>
          )
        }
        <p class="band-link">
          <a href={routePath('blog', locale)}>{t('home.posts.all')} →</a>
        </p>

        <div class="newsletter">
          <div>
            <h3>{t('home.newsletter.title')}</h3>
            <p>{t('home.newsletter.body')}</p>
          </div>
          <div class="newsletter-actions">
            {
              NEWSLETTER_URL ? (
                <a class="button" href={NEWSLETTER_URL}>
                  {t('newsletter.subscribe')}
                </a>
              ) : (
                <a
                  class="button"
                  href={`mailto:${CONTACT_EMAIL}?subject=Field%20note%20newsletter`}
                >
                  {t('newsletter.mailFallback')}
                </a>
              )
            }
            <a class="newsletter-write" href={routePath('contribute', locale)}>
              {t('home.newsletter.write')} →
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* The banner's frame: paper, grid, one red edge on the leading side. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    padding-block: var(--space-8);
    background-color: var(--bg);
    border-block-end: var(--border-width) solid var(--border);
  }

  /* One screen of grid, exactly: the section takes the viewport minus the
     header, so the pattern meets the fold instead of stopping in an arbitrary
     band, and the index strip sits on the edge as the cue that there is more.
     svh, not vh, so a collapsing mobile URL bar cannot break that promise.
     Only from 48rem up: below it the header wraps to two rows (height unknown
     here) and the copy already overflows a phone screen, so the floor would
     only push the strip out of view. */
  @media (min-width: 48rem) {
    .hero {
      min-height: calc(100svh - var(--header-height));
    }
  }

  .hero::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 6px;
    background: var(--accent);
  }

  .hero-motto {
    color: var(--fg-subtle);
  }

  /* 16ch was a slide's measure — on a laptop it broke the sentence into four
     stacked lines that read as four statements. 22ch keeps the display register
     while letting the line hold a clause. */
  .hero h1 {
    margin-block-start: var(--space-4);
    max-width: 22ch;
  }

  .hero-subtitle {
    margin-block-start: var(--space-5);
    font-size: var(--text-lg);
    color: var(--fg-muted);
    max-width: 46ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  /* Three columns of the page's own contents, on the fold. */
  .hero-index {
    display: grid;
    gap: 0;
    list-style: none;
    padding: 0;
    margin: var(--space-7) 0 0;
    border-block-start: var(--border-width) solid var(--border-strong);
  }

  .hero-index a {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-3);
    color: var(--fg);
    text-decoration: none;
    border-block-end: var(--border-width) solid var(--border);
  }

  .hero-index a:hover .hero-index-title {
    color: var(--accent-strong);
  }

  /* Metadata numerals, not actions — they stay in the grey ramp so the
     hero's red budget belongs to the edge and the primary button. */
  .hero-index-num {
    color: var(--fg-subtle);
  }

  .hero-index-title {
    font-weight: 550;
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (min-width: 48rem) {
    .hero-index {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }

    .hero-index a {
      border-block-end: 0;
    }
  }

  /* --- the next edition, once, at full width ------------------------------ */

  /* A ticket, not a paragraph that happens to sit in a box: the kicker rules
     off a header band, and the registration column is a column of the same
     record — it used to be a bordered, differently-coloured card nested
     inside this one, three rectangles deep with a full-bleed red bar at the
     bottom of it. */
  .feature {
    position: relative;
    margin-block-start: var(--space-7);
    padding: var(--space-5);
    border: var(--border-width) solid var(--border-strong);
    border-inline-start: 3px solid var(--accent);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
  }

  @media (min-width: 48rem) {
    .feature {
      padding: var(--space-5) var(--space-6);
    }
  }

  .feature-kicker {
    color: var(--fg-subtle);
    padding-block-end: var(--space-4);
    border-block-end: var(--border-width) solid var(--border);
  }

  .feature-grid {
    display: grid;
    gap: var(--space-5);
    padding-block-start: var(--space-5);
  }

  /* The panel stops the block ending in a dead right column at desktop width,
     which is what the single centred card did before. 64rem, not 56rem: below
     it the two columns each get too little width to set their own type, and
     the CTA is the thing that pays for it. */
  @media (min-width: 64rem) {
    .feature-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      align-items: start;
      gap: var(--space-6);
    }

    /* One hairline instead of a box. Stretched, so the rule spans the whole
       record rather than stopping under the button. */
    .feature-panel {
      align-self: stretch;
      padding-block-start: 0;
      border-block-start: 0;
      padding-inline-start: var(--space-6);
      border-inline-start: var(--border-width) solid var(--border);
    }
  }

  /* Date and time carry this block, so they sit in the ink ramp at reading
     size. All six facts used to run together in one uppercase mono line at
     label size and label colour, which reads as fine print — not as the one
     thing a visitor came to find. */
  .feature-when {
    margin-block-start: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    font-variant-numeric: tabular-nums;
  }

  .feature-where {
    margin-block-start: var(--space-1);
    color: var(--fg-muted);
  }

  .feature-language {
    margin-block-start: var(--space-3);
    color: var(--fg-subtle);
    font-size: var(--text-sm);
  }

  /* Stacked, the same hairline runs across instead of down — the ticket keeps
     its stub at every width. */
  .feature-panel {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    align-content: start;
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--border);
  }

  /* Label above value, not a sentence around a bold fragment: at panel width
     "Aanmelden opent 2 september 2026" broke after the "2", orphaning the day
     from its month. */
  .feature-registration {
    display: grid;
    gap: var(--space-1);
  }

  .feature-registration-label {
    color: var(--fg-subtle);
  }

  .feature-registration-date {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  /* --- the three bands ---------------------------------------------------- */

  .intro,
  .band {
    margin-block-start: var(--space-8);
  }

  .band-index {
    color: var(--fg-subtle);
    padding-block-end: var(--space-3);
    border-block-start: var(--border-width) solid var(--border-strong);
    padding-block-start: var(--space-3);
  }

  /* Heading and intro sit side by side so the section head uses the full
     measure instead of stacking two prose-width blocks against a dead column. */
  .band-head {
    display: grid;
    gap: var(--space-3);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .band-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: var(--space-7);
    }
  }

  .band-head h2 {
    font-size: var(--text-2xl);
    max-width: 18ch;
  }

  .band-intro {
    color: var(--fg-muted);
    font-size: var(--text-lg);
    max-width: 52ch;
  }

  .band-content {
    margin-block-start: var(--space-6);
  }

  .band-link {
    margin-block-start: var(--space-4);
    font-weight: 550;
  }

  .band-link a {
    text-decoration: none;
  }

  .band-link a:hover {
    text-decoration: underline;
  }

  .event-grid,
  .post-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .event-grid,
    .post-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-6);
    }
  }

  .note {
    padding: var(--space-5);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-subtle);
  }

  .note p {
    color: var(--fg-muted);
    margin-block-start: var(--space-3);
    max-width: var(--width-prose);
  }

  .newsletter {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
    padding: var(--space-5);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
  }

  @media (min-width: 56rem) {
    .newsletter {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-7);
    }
  }

  .newsletter p {
    color: var(--fg-muted);
    margin-block-start: var(--space-3);
    max-width: 60ch;
  }

  .newsletter-actions {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .newsletter-write {
    font-size: var(--text-sm);
    font-weight: 550;
  }

  .empty {
    color: var(--fg-muted);
  }
</style>
