---
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import type { CompanyEntry } from '../lib/content.ts';
import Tag from './Tag.astro';

interface Props {
  company: CompanyEntry;
  locale: Locale;
  openJobs?: number;
  /** Heading level of the card title — h2 on list pages, h3 under a section. */
  headingLevel?: 'h2' | 'h3';
}

const { company, locale, openJobs = 0, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const t = useTranslations(locale);
const href = routePath('companies', locale, company.id);

// "11-50" is stored with a hyphen; ranges render with an en dash.
const sizeLabel = company.data.size.replace('-', '–');
---

<article class="company-card">
  <div class="company-head">
    <Heading class="company-name">
      <a href={href}>{company.data.name}</a>
    </Heading>
    {company.data.fixture && <Tag>{t('common.fixture')}</Tag>}
    {company.data.hiring && <Tag variant="accent">{t('companies.hiring')}</Tag>}
  </div>

  <p class="company-desc">{company.data.description[locale]}</p>

  <p class="company-meta">
    <span>{company.data.locations.join(', ')}</span>
    <span aria-hidden="true">·</span>
    <span>{sizeLabel}</span>
    {
      openJobs > 0 && (
        <>
          <span aria-hidden="true">·</span>
          <span>
            {openJobs}{' '}
            {(openJobs === 1 ? t('companies.openJob') : t('companies.openJobs')).toLowerCase()}
          </span>
        </>
      )
    }
  </p>

  <ul class="company-stack">
    {
      company.data.stack.slice(0, 5).map((tech) => (
        <li>
          <Tag>{tech}</Tag>
        </li>
      ))
    }
  </ul>
</article>

<style>
  .company-card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-raised);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .company-card:hover {
    border-color: var(--border-strong);
  }

  .company-card:focus-within {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .company-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .company-name {
    font-size: var(--text-lg);
    margin: 0;
  }

  .company-name a {
    color: var(--fg);
    text-decoration: none;
  }

  .company-name a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .company-name a:focus-visible {
    outline: none;
  }

  .company-desc {
    color: var(--fg-muted);
    font-size: var(--text-sm);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .company-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--fg-subtle);
    font-size: var(--text-xs);
  }

  .company-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
