---
import { LOCALE_TAGS } from '../i18n/config.ts';
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/utils.ts';
import type { SlugInput } from '../i18n/utils.ts';
import type { RouteKey } from '../i18n/routes.ts';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Rum from '../components/Rum.astro';
import '../styles/global.css';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  slug?: SlugInput;
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  errorPage?: boolean;
}

const { locale, routeKey, slug, title, description, ogType, jsonLd, noindex, errorPage } =
  Astro.props;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={LOCALE_TAGS[locale]}>
  <head>
    <BaseHead
      locale={locale}
      routeKey={routeKey}
      slug={slug}
      title={title}
      description={description}
      ogType={ogType}
      jsonLd={jsonLd}
      noindex={noindex}
      errorPage={errorPage}
    />
    <script is:inline>
      (function () {
        const fallBackToPrefersColorScheme = function () {};
        try {
          const stored = localStorage.getItem('twente-dev-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          fallBackToPrefersColorScheme();
        }
      })();
    </script>
  </head>
  <body data-pagefind-ignore={noindex ? 'all' : undefined}>
    <a class="skip-link" href="#main">{t('nav.skipToContent')}</a>
    <Header locale={locale} current={routeKey} slug={slug} />
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <Footer locale={locale} />
    <Rum />
  </body>
</html>
