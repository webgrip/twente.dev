---
import { LOCALE_TAGS, SITE_URL } from '../i18n/config.ts';
import type { Locale } from '../i18n/config.ts';
import { absoluteUrl, getAlternates, slugFor, useTranslations } from '../i18n/utils.ts';
import type { SlugInput } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import type { RouteKey } from '../i18n/routes.ts';
import { organisationSchema, websiteSchema } from '../lib/jsonld.ts';
import { ANALYTICS_TOKEN } from '../config/site.ts';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import plexMonoWoff2 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  slug?: SlugInput;
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  errorPage?: boolean;
}

const {
  locale,
  routeKey,
  slug,
  title,
  description,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
  errorPage = false,
} = Astro.props;

const t = useTranslations(locale);
const siteName = t('site.name');

const isHome = routeKey === 'home' && !slug && !errorPage;

const fullTitle = isHome ? `${siteName} // ${t('site.tagline')}` : `${title} // ${siteName}`;

const ogTitle = isHome ? fullTitle : title;

const canonicalSlug = slugFor(slug, locale);
const canonical = absoluteUrl(routePath(routeKey, locale, canonicalSlug));
const { alternates, xDefault } = getAlternates(routeKey, slug);

const ogImage: string | undefined = absoluteUrl('/brand/social/banner-meetup-1200x675@2x.png');
const ogImageAlt = `${siteName} // ${t('site.tagline')}`;

const twitterCard = ogImage ? 'summary_large_image' : 'summary';

const graph = [organisationSchema(), websiteSchema(), ...jsonLd];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
{!errorPage && <link rel="canonical" href={canonical} />}

{noindex && <meta name="robots" content="noindex, nofollow" />}

{
  !errorPage &&
    alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)
}
{!errorPage && xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
{!errorPage && <meta property="og:url" content={canonical} />}
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={LOCALE_TAGS[locale].replace('-', '_')} />
{
  ogImage && (
    <>
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="675" />
      <meta property="og:image:alt" content={ogImageAlt} />
    </>
  )
}

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
{ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}

<meta name="theme-color" content="#f7f3ea" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#111820" media="(prefers-color-scheme: dark)" />

<link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={plexMonoWoff2} crossorigin />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${siteName} // ${t('blog.title')}`}
  href={`${SITE_URL}/${locale}/rss.xml`}
/>
<link
  rel="alternate"
  type="text/calendar"
  title={`${siteName} // ${t('events.title')}`}
  href={`${SITE_URL}/events.ics`}
/>

<script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />

{
  ANALYTICS_TOKEN && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: ANALYTICS_TOKEN })}
    />
  )
}
