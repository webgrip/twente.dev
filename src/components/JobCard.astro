---
import type { Locale } from '../i18n/config.ts';
import { formatDate, useTranslations } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import type { CompanyEntry, JobEntry } from '../lib/content.ts';
import Tag from './Tag.astro';

interface Props {
  job: JobEntry;
  company: CompanyEntry | undefined;
  locale: Locale;
  /** Heading level of the card title — h2 on list pages, h3 under a section. */
  headingLevel?: 'h2' | 'h3';
}

const { job, company, locale, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const t = useTranslations(locale);

const workplaceLabel = {
  remote: t('jobs.remote'),
  hybrid: t('jobs.hybrid'),
  onsite: t('jobs.onsite'),
}[job.data.workplace];

// Schema enums are storage values, never display strings — "medior" reads as
// a typo to international applicants and "full-time" is English on NL pages.
const seniorityLabel = {
  junior: t('jobs.seniority.junior'),
  medior: t('jobs.seniority.medior'),
  senior: t('jobs.seniority.senior'),
  lead: t('jobs.seniority.lead'),
  any: t('jobs.seniority.any'),
}[job.data.seniority];

const languageLabel =
  job.data.languageRequirement === 'dutch-required' ? t('jobs.dutchRequired') : t('jobs.englishOk');

const href = routePath('jobs', locale, job.id);
---

<article class="job-card">
  <div class="job-head">
    <Heading class="job-title">
      <!-- Whole-card click target via ::after, so the accessible name stays the title. -->
      <a href={href}>{job.data.title[locale]}</a>
    </Heading>
    <p class="job-company">{company?.data.name ?? job.data.company.id}</p>
  </div>

  <p class="job-meta">
    <span>{job.data.city}</span>
    <span aria-hidden="true">·</span>
    <span>{workplaceLabel}</span>
    <span aria-hidden="true">·</span>
    <span>{seniorityLabel}</span>
  </p>

  <ul class="job-tags">
    {
      job.data.fixture && (
        <li>
          <Tag>{t('common.fixture')}</Tag>
        </li>
      )
    }
    <li>
      <Tag variant={job.data.languageRequirement === 'english-ok' ? 'accent' : 'default'}
        >{languageLabel}</Tag
      >
    </li>
    {
      job.data.stack.slice(0, 4).map((tech) => (
        <li>
          <Tag>{tech}</Tag>
        </li>
      ))
    }
  </ul>

  <p class="job-date">
    <span class="visually-hidden">{t('jobs.postedOn')}</span>
    <time datetime={job.data.postedAt.toISOString()}>{formatDate(job.data.postedAt, locale)}</time>
  </p>
</article>

<style>
  .job-card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-raised);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .job-card:hover {
    border-color: var(--border-strong);
  }

  .job-card:focus-within {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .job-title {
    font-size: var(--text-lg);
    margin: 0;
  }

  .job-title a {
    color: var(--fg);
    text-decoration: none;
  }

  .job-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .job-title a:focus-visible {
    outline: none;
  }

  /* Metadata, not an action — red company names made /vacatures a column of
     red lines (and raw --accent as text fails contrast on dark surfaces). */
  .job-company {
    color: var(--fg-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .job-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .job-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .job-date {
    color: var(--fg-subtle);
    font-size: var(--text-xs);
  }
</style>
