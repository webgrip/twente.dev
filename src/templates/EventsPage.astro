---
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/utils.ts';
import { getPastEvents, getUpcomingEvents } from '../lib/content.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EventCard from '../components/EventCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const [upcoming, past] = await Promise.all([getUpcomingEvents(), getPastEvents()]);

/**
 * Subscription targets for the one shared feed. `webcal://` makes Apple
 * Calendar and Outlook open a *subscription* (auto-refreshing) instead of a
 * one-off import; Google needs the same URL passed through its add-by-URL
 * route. The plain file stays for everything else.
 */
const WEBCAL_URL = 'webcal://twente.dev/events.ics';
const GOOGLE_CALENDAR_URL = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(WEBCAL_URL)}`;
---

<BaseLayout
  locale={locale}
  routeKey="events"
  title={t('events.title')}
  description={t('events.description')}
>
  <div class="container">
    <PageHeader title={t('events.title')} description={t('events.description')}>
      <div class="subscribe">
        <p class="subscribe-title">{t('events.subscribe')}</p>
        <p class="subscribe-hint">{t('events.subscribeHint')}</p>
        <ul class="subscribe-links" role="list">
          <li>
            <a href={GOOGLE_CALENDAR_URL} rel="noopener">{t('events.subscribeGoogle')}</a>
          </li>
          <li><a href={WEBCAL_URL}>{t('events.subscribeWebcal')}</a></li>
          <li><a href="/events.ics">{t('events.subscribeDirect')}</a></li>
        </ul>
      </div>
    </PageHeader>

    <h2>{t('events.upcoming')}</h2>
    <div class="event-grid">
      {upcoming.length === 0 && <p class="empty">{t('events.empty')}</p>}
      {upcoming.map((event) => <EventCard event={event} locale={locale} />)}
    </div>

    {
      past.length > 0 && (
        <>
          <h2 class="past-heading">{t('events.past')}</h2>
          <div class="event-grid">
            {past.slice(0, 12).map((event) => (
              <EventCard event={event} locale={locale} />
            ))}
          </div>
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .subscribe {
    margin-block-start: var(--space-4);
    padding: var(--space-4);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-lg);
    max-width: 34rem;
  }

  .subscribe-title {
    font-weight: 650;
  }

  .subscribe-hint {
    font-size: var(--text-sm);
    color: var(--fg-subtle);
    margin-block-start: var(--space-1);
  }

  .subscribe-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 550;
  }

  h2 {
    font-size: var(--text-xl);
    margin-block-end: var(--space-4);
  }

  .past-heading {
    margin-block-start: var(--space-8);
  }

  .event-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .event-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .empty {
    color: var(--fg-muted);
  }
</style>
