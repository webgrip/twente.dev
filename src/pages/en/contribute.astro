---
import ProsePage from '../../templates/ProsePage.astro';
import { CONTACT_EMAIL, REPO_URL } from '../../config/site.ts';
---

<ProsePage
  locale="en"
  routeKey="contribute"
  title="Contribute"
  description="Contribution is how this community grows. We are still working out the full routes — email is always open."
>
  <p>
    Contribution is how this community grows: a story, a demo, an introduction, a listed event, a
    volunteer shift, a room. We are working out the routes right now; this page will grow with them.
  </p>
  <p>
    Want to contribute something already? Email
    <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> — one sentence is enough to start the conversation.
    Found something broken or wrong on the site?
    <a href={REPO_URL}>Open an issue in the repository</a>.
  </p>
</ProsePage>
