{
  "name": "@webgrip/twente.dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "twente.dev — the homepage for software developers in Twente. Bilingual (NL/EN) static community hub and blog.",
  "repository": {
    "type": "git",
    "url": "https://forgejo.webgrip.dev/webgrip/twente.dev.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pnpm run index:search && pnpm run validate:csp && pnpm run validate:commitments",
    "index:search": "pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --experimental-strip-types \"src/lib/**/*.test.ts\"",
    "validate:content": "node --experimental-strip-types scripts/validate-content.ts",
    "validate:csp": "node --experimental-strip-types scripts/validate-csp.ts",
    "validate:mail-auth": "node --experimental-strip-types scripts/validate-mail-auth.ts",
    "validate:mail": "node --experimental-strip-types scripts/build-mail.ts --check",
    "banners": "node --experimental-strip-types scripts/sync-editie.mjs && node scripts/export-banners.mjs",
    "gen:ops": "node --experimental-strip-types scripts/gen-ops.ts",
    "mail": "node --experimental-strip-types scripts/build-mail.ts",
    "mail:draft": "node --experimental-strip-types scripts/mail-draft.ts",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "validate:a11y": "node --experimental-strip-types scripts/axe-scan.ts",
    "validate:commitments": "node --experimental-strip-types scripts/validate-commitments.ts"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "7.1.6",
    "web-vitals": "6.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.1.0",
    "pagefind": "1.5.2",
    "playwright-core": "^1.56.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "wrangler": "4.118.0",
    "yaml": "2.9.0"
  }
}
