---
import type { GetStaticPaths } from 'astro';

import { getCompanies, getOpenJobs } from '../../../lib/content.ts';
import CompanyDetailPage from '../../../templates/CompanyDetailPage.astro';

export const getStaticPaths = (async () => {
  const [companies, jobs] = await Promise.all([getCompanies(), getOpenJobs()]);
  return companies.map((company) => ({
    params: { slug: company.id },
    props: { company, jobs: jobs.filter((job) => job.data.company.id === company.id) },
  }));
}) satisfies GetStaticPaths;

const { company, jobs } = Astro.props;
---

<CompanyDetailPage company={company} jobs={jobs} locale="en" />
