---
import { LOCALE_TAGS, SITE_URL } from '../i18n/config.ts';
import type { Locale } from '../i18n/config.ts';
import { absoluteUrl, getAlternates, slugFor, useTranslations } from '../i18n/utils.ts';
import type { SlugInput } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import type { RouteKey } from '../i18n/routes.ts';
import { organisationSchema, websiteSchema } from '../lib/jsonld.ts';
import { ANALYTICS_TOKEN } from '../config/site.ts';

/**
 * Every SEO-critical tag lives here, driven by props, so it is structurally
 * impossible to ship a page without a canonical, hreflang alternates or an OG
 * image. Per the plan (§7) this is wired into the base layout rather than
 * repeated per page precisely so it cannot be forgotten.
 */
interface Props {
  locale: Locale;
  routeKey: RouteKey;
  slug?: SlugInput;
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  /** Page-specific structured data, appended to the site-wide graph. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  locale,
  routeKey,
  slug,
  title,
  description,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const t = useTranslations(locale);
const siteName = t('site.name');

// The homepage's <title> should not read "twente.dev — twente.dev".
const fullTitle =
  routeKey === 'home' && !slug ? `${siteName} — ${t('site.tagline')}` : `${title} — ${siteName}`;

const canonicalSlug = slugFor(slug, locale);
const canonical = absoluteUrl(routePath(routeKey, locale, canonicalSlug));
const { alternates, xDefault } = getAlternates(routeKey, slug);

/**
 * Open Graph image: the brand pack's social banner (1200×627). It carries the
 * "Reconnect" campaign lockup (twente.dev/001 · 07.10 · Enschede), which per
 * the playbook is the launch-phase device — replace or generalise it after
 * edition 001. A per-page generator (plan lever L7) can override this later.
 */
const ogImage: string | undefined = absoluteUrl('/brand/twente-dev-social-banner.png');

// `summary_large_image` promises an image; without one, `summary` is honest.
const twitterCard = ogImage ? 'summary_large_image' : 'summary';

const graph = [organisationSchema(), websiteSchema(locale), ...jsonLd];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={LOCALE_TAGS[locale].replace('-', '_')} />
{
  ogImage && (
    <>
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="627" />
    </>
  )
}

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${siteName} — ${t('blog.title')}`}
  href={`${SITE_URL}/${locale}/rss.xml`}
/>
<link
  rel="alternate"
  type="text/calendar"
  title={`${siteName} — ${t('events.title')}`}
  href={`${SITE_URL}/events.ics`}
/>

<script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />

{
  /**
   * Cloudflare Web Analytics (ADR-0006) — renders only once a token exists in
   * src/config/site.ts. Enabling it also requires widening the CSP in
   * astro.config.mjs: add https://static.cloudflareinsights.com to
   * scriptDirective.resources and https://cloudflareinsights.com to
   * connect-src. Cookieless, so no consent banner — but the privacy page's
   * "no third-party scripts" wording must be updated in the same change.
   */
  ANALYTICS_TOKEN && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: ANALYTICS_TOKEN })}
    />
  )
}
