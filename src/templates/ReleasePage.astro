---
import type { Locale } from '../i18n/config.ts';
import {
  formatDate,
  formatTime,
  formatTimeRange,
  formatWeekday,
  useTranslations,
} from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import {
  MEETUP_GROUP_URL,
  REGISTRATION_OPENS,
  REGISTRATION_URL,
  releaseName,
} from '../config/site.ts';
import type { EventEntry } from '../lib/content.ts';
import { resolveRelease } from '../lib/release.ts';
import { eventSchema } from '../lib/jsonld.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import VenueMap from '../components/VenueMap.astro';

interface Props {
  locale: Locale;
  entry: EventEntry;
}

interface Copy {
  metaTitle: string;
  metaDescription: string;
  intro: string;
  factDate: string;
  factTime: string;
  factVenue: string;
  factLanguage: string;
  factCost: string;
  factCapacity: string;
  factsTitle: string;
  onThisPage: string;
  slotOpen: string;
  slotLabel: string;
  outcomes: [string, string, string];
  eveningTitle: string;
  runOfShow: { time: string; item: string }[];
  whoBody: string;
  whoWelcome: string;
  speakersTitle: string;
  speakersTba: string;
  speakersTbaBody: string;
  speakersCta: string;
  speakersMailCta: string;
  locationTitle: string;
  registrationTitle: string;
  registrationOpenBody: string;
  registrationOpens: string;
  registrationOpensSuffix: string;
  registrationJoinGroup: string;
  registrationCta: string;
  meetupGroupCta: string;
  registrationCalendarHint: string;
  updatesTitle: string;
  updatesBody: string;
  consentNote: string;
  practicalTitle: string;
  practical: { term: string; detail: string }[];
  conductCta: string;
  partnersCta: string;
}

const { locale, entry } = Astro.props;
const release = resolveRelease(entry.data);

const name = `${releaseName(release.number)}: ${release.theme}`;
const time = formatTime;
const hours = formatTimeRange(release.doors, release.end);
const speakers = release.speakers;
const sentenceCase = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
const whenWhere = (loc: Locale) =>
  `${sentenceCase(formatWeekday(release.doors, loc))} ${formatDate(release.doors, loc)}, ${hours}, ${release.city}`;
const talkRow = (position: number, tba: string) =>
  `Talk ${position} // ${speakers[position - 1]?.name ?? tba}`;

const COPY: Record<Locale, Copy> = {
  en: {
    metaTitle: name,
    metaDescription: `One evening for everyone who builds technology in Twente. ${whenWhere('en')}. Free.`,
    intro: `${name} is an evening for everyone building technology in and around Twente, whatever they build it with: software, infrastructure, embedded, manufacturing, data, security, design, product, research and education. Two half-hour talks about something the speaker built, fixed or broke themselves, then a good hour to actually meet each other. Free, food included.`,
    factDate: 'Date',
    factTime: 'Time',
    factVenue: 'Venue',
    factLanguage: 'Language',
    factCost: 'Cost',
    factCapacity: 'Seats',
    factsTitle: 'The facts',
    onThisPage: 'On this page',
    slotOpen: 'Open',
    slotLabel: 'Slot',
    outcomes: ['One useful idea', 'One useful introduction', 'One reason to return'],
    eveningTitle: 'The evening',
    runOfShow: [
      { time: time(release.doors), item: 'Doors, food and first introductions' },
      { time: time(release.start), item: 'Welcome' },
      { time: '19:00', item: talkRow(1, 'speaker to follow') },
      { time: '19:30', item: 'Break' },
      { time: '19:45', item: talkRow(2, 'speaker to follow') },
      { time: '20:15', item: 'Networking hour' },
      { time: time(release.end), item: 'Hard finish' },
    ],
    whoBody:
      'For everyone who builds or applies technology, at any stage of their career, in and around Twente.',
    whoWelcome: 'First-timers and people coming alone are explicitly welcome.',
    speakersTitle: 'Speakers',
    speakersTba: 'Speakers to follow',
    speakersTbaBody:
      'Both talk slots are open. The call is running, speakers are picked editorially and stage time is not for sale, so names go up once they are confirmed. What is already fixed: half an hour per talk, about something you built, fixed or broke yourself. No speaking experience needed, we shape the talk together.',
    speakersCta: 'Propose a talk',
    speakersMailCta: 'Email me when the programme is set',
    locationTitle: 'Venue',
    registrationTitle: 'Register',
    registrationOpenBody:
      'Registration runs on Meetup. One click and your place is set. Cannot make it after all? Set your RSVP to no there and your place goes to the waitlist.',
    registrationOpens: 'Registration opens',
    registrationOpensSuffix: 'on Meetup.',
    registrationJoinGroup: 'Join the group now and you will see it the moment it opens.',
    registrationCta: 'Reserve a place on Meetup',
    meetupGroupCta: 'twente.dev on Meetup',
    registrationCalendarHint: 'Subscribe to the calendar and the date is already in yours.',
    updatesTitle: 'Rather get an email?',
    updatesBody:
      'One message when the programme is set and one when registration opens. Nothing else.',
    consentNote:
      'Registering on Meetup never adds you to the newsletter. That is a separate, explicit opt-in.',
    practicalTitle: 'Practical',
    practical: [
      {
        term: 'Food',
        detail:
          'Food and non-alcoholic drinks are included. Dietary needs are asked when you register.',
      },
      {
        term: 'Access',
        detail:
          'Step-free route, seating, sound and a quiet space: the details are on this page at least two weeks before the evening.',
      },
      {
        term: 'Photos and video',
        detail:
          'We take photos and video for the archive. Rather not be in shot? Say so when you register or at check-in. If you end up in something anyway, one message is enough to have it removed.',
      },
      {
        term: 'Ground rules',
        detail:
          'The code of conduct applies, with a named contact on the night and a route that does not run through the host. Sponsors get no attendee data, stage time is not for sale, and this is no job fair: attendees are not leads.',
      },
    ],
    conductCta: 'Read the code of conduct',
    partnersCta: 'The terms with partners',
  },
  nl: {
    metaTitle: name,
    metaDescription: `Eén avond voor iedereen die in Twente technologie bouwt. ${whenWhere('nl')}. Gratis.`,
    intro: `${name} is een avond voor iedereen die in en rondom Twente technologie bouwt, met welke techniek dan ook: software, infrastructuur, embedded, maakindustrie, data, security, design, product, onderzoek en onderwijs. Twee talks van een halfuur over iets dat de spreker zelf heeft gebouwd, gerepareerd of verprutst, en daarna een ruim uur om elkaar echt te spreken. Gratis, eten inbegrepen.`,
    factDate: 'Datum',
    factTime: 'Tijd',
    factVenue: 'Locatie',
    factLanguage: 'Voertaal',
    factCost: 'Kosten',
    factCapacity: 'Plekken',
    factsTitle: 'De feiten',
    onThisPage: 'Op deze pagina',
    slotOpen: 'Open',
    slotLabel: 'Talkplek',
    outcomes: ['Eén nuttig idee', 'Eén nuttige kennismaking', 'Eén reden om terug te komen'],
    eveningTitle: 'De avond',
    runOfShow: [
      { time: time(release.doors), item: 'Inloop, eten en eerste kennismakingen' },
      { time: time(release.start), item: 'Welkomstwoord' },
      { time: '19:00', item: talkRow(1, 'spreker volgt') },
      { time: '19:30', item: 'Pauze' },
      { time: '19:45', item: talkRow(2, 'spreker volgt') },
      { time: '20:15', item: 'Netwerkuur' },
      { time: time(release.end), item: 'Strakke eindtijd' },
    ],
    whoBody:
      'Voor iedereen die technologie bouwt of toepast, in elke fase van je loopbaan, in en rond Twente.',
    whoWelcome: 'Nieuwkomers en mensen die alleen komen zijn nadrukkelijk welkom.',
    speakersTitle: 'Sprekers',
    speakersTba: 'Sprekers volgen',
    speakersTbaBody:
      'Beide talkplekken staan open. De open call loopt, sprekers kiezen we redactioneel en spreektijd is niet te koop, dus namen komen erbij zodra ze bevestigd zijn. Wat al vaststaat: een halfuur per talk, over iets dat je zelf hebt gebouwd, gerepareerd of verprutst. Spreekervaring is niet nodig, we werken het verhaal samen uit.',
    speakersCta: 'Meld een verhaal aan',
    speakersMailCta: 'Mail me als het programma rond is',
    locationTitle: 'Locatie',
    registrationTitle: 'Aanmelden',
    registrationOpenBody:
      'Aanmelden loopt via Meetup. Eén klik, en je plek staat vast. Kun je toch niet, zet je RSVP daar op nee, dan gaat je plek naar de wachtlijst.',
    registrationOpens: 'Aanmelden opent',
    registrationOpensSuffix: 'op Meetup.',
    registrationJoinGroup: 'Word alvast lid van de groep, dan zie je het zodra het opengaat.',
    registrationCta: 'Reserveer een plek op Meetup',
    meetupGroupCta: 'twente.dev op Meetup',
    registrationCalendarHint: 'Abonneer op de agenda, dan staat de datum er alvast in.',
    updatesTitle: 'Liever een mail?',
    updatesBody:
      'Eén bericht zodra het programma rond is en één zodra aanmelden opent. Verder niets.',
    consentNote:
      'Aanmelden op Meetup zet je nooit op de nieuwsbrief. Dat is een aparte, expliciete opt-in.',
    practicalTitle: 'Praktisch',
    practical: [
      {
        term: 'Eten',
        detail:
          'Eten en non-alcoholische drankjes zijn inbegrepen. Dieetwensen geef je door bij je aanmelding.',
      },
      {
        term: 'Toegankelijkheid',
        detail:
          'Drempelvrije route, zitplaatsen, geluid en een rustige ruimte: de details staan uiterlijk twee weken voor de avond op deze pagina.',
      },
      {
        term: 'Foto en video',
        detail:
          'We maken foto’s en video voor het archief. Liever niet in beeld? Zeg het bij je aanmelding of bij de check-in. Sta je er achteraf toch op, dan is één bericht genoeg om het te laten verwijderen.',
      },
      {
        term: 'Afspraken',
        detail:
          'De gedragscode geldt, met een benoemd aanspreekpunt op de avond en een route die niet via de gastheer loopt. Sponsors krijgen geen deelnemersdata, spreektijd is niet te koop, en dit is geen banenmarkt: deelnemers zijn geen leads.',
      },
    ],
    conductCta: 'Lees de gedragscode',
    partnersCta: 'De afspraken met partners',
  },
};

const c = COPY[locale];
const t = useTranslations(locale);
const jsonLd = [eventSchema(entry, locale)];

const registrationOpen = REGISTRATION_URL !== null;
const primaryHref = REGISTRATION_URL ?? MEETUP_GROUP_URL;
const sections = [
  { id: 'avond', label: c.eveningTitle },
  { id: 'sprekers', label: c.speakersTitle },
  { id: 'locatie', label: c.locationTitle },
  { id: 'aanmelden', label: c.registrationTitle },
  { id: 'praktisch', label: c.practicalTitle },
] as const;
const num = (id: (typeof sections)[number]['id']) =>
  String(sections.findIndex((s) => s.id === id) + 1).padStart(2, '0');
const opensIso = REGISTRATION_OPENS.toISOString();
const opensOn = formatDate(REGISTRATION_OPENS, locale);
---

<BaseLayout
  locale={locale}
  routeKey="release"
  slug={release.number}
  title={c.metaTitle}
  description={c.metaDescription}
  jsonLd={jsonLd}
>
  <div class="container release">
    <div class="release-grid">
      <header class="release-hero grid-band">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a class="label-mono" href={routePath('events', locale)}>
            <span aria-hidden="true">←</span>
            {t('events.title')}
          </a>
        </nav>
        <p class="release-lockup label-mono" aria-hidden="true">
          <span class="lockup-name">{releaseName(release.number)}</span>
          <span class="lockup-date">
            {String(release.doors.getDate()).padStart(2, '0')}.{
              String(release.doors.getMonth() + 1).padStart(2, '0')
            }
          </span>
          <span class="lockup-place">{release.city} · {time(release.doors)}</span>
        </p>
        <h1 class="text-display">{release.theme}</h1>
        <p class="release-intro">{c.intro}</p>

        <ul class="outcomes" role="list">
          {c.outcomes.map((outcome) => <li>{outcome}</li>)}
        </ul>
      </header>

      <aside class="release-aside" aria-labelledby="release-facts">
        <div class="release-aside-inner">
          <div class="aside-card">
            <h2 class="visually-hidden" id="release-facts">{c.factsTitle}</h2>
            <dl class="facts">
              <div>
                <dt>{c.factDate}</dt>
                <dd>
                  <time datetime={release.doors.toISOString()}>
                    {formatDate(release.doors, locale)}
                  </time>
                </dd>
              </div>
              <div>
                <dt>{c.factTime}</dt>
                <dd>{hours}</dd>
              </div>
              <div>
                <dt>{c.factVenue}</dt>
                <dd>
                  <a href="#locatie"
                    >{release.venue ?? `${release.city}, ${t('release.venueTba')}`}</a
                  >
                </dd>
              </div>
              <div>
                <dt>{c.factCapacity}</dt>
                <dd>{release.capacity}</dd>
              </div>
              <div>
                <dt>{c.factCost}</dt>
                <dd>{t('release.free')}</dd>
              </div>
              <div>
                <dt>{c.factLanguage}</dt>
                <dd class="fact-long">{t('release.language')}</dd>
              </div>
            </dl>
            {
              primaryHref && (
                <a class="button button--primary aside-cta" href={primaryHref} rel="noopener">
                  {registrationOpen ? c.registrationCta : c.meetupGroupCta}
                </a>
              )
            }
            {
              !registrationOpen && (
                <p class="aside-note">
                  {c.registrationOpens} <time datetime={opensIso}>{opensOn}</time>
                </p>
              )
            }
          </div>
          <nav class="aside-index aside-card" aria-labelledby="aside-index-title">
            <p class="label-mono aside-index-title" id="aside-index-title">{c.onThisPage}</p>
            <ol role="list">
              {
                sections.map((section, index) => (
                  <li>
                    <a href={`#${section.id}`}>
                      <span class="label-mono aside-index-num">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span>{section.label}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </div>
      </aside>

      <div class="release-main">
        <section class="release-section reveal" id="avond">
          <p class="label-mono section-index">{num('avond')}</p>
          <h2>{c.eveningTitle}</h2>
          <ol class="run-of-show" role="list">
            {
              c.runOfShow.map(({ time: at, item }) => (
                <li>
                  <span class="ros-time">{at}</span>
                  <span class="ros-item">{item}</span>
                </li>
              ))
            }
          </ol>
          <p class="who">
            {c.whoBody}
            <strong>{c.whoWelcome}</strong>
          </p>
        </section>

        <section class="release-section reveal" id="sprekers">
          <p class="label-mono section-index">{num('sprekers')}</p>
          <h2>{c.speakersTitle}</h2>
          {
            speakers.length === 0 ? (
              <div class="speakers-tba">
                <ul class="slots" role="list">
                  {[1, 2].map((position) => (
                    <li>
                      <span class="label-mono slot-name">
                        {c.slotLabel} {position}
                      </span>
                      <span class="label-mono slot-state">{c.slotOpen}</span>
                    </li>
                  ))}
                </ul>
                <p class="speakers-badge label-mono">{c.speakersTba}</p>
                <p>{c.speakersTbaBody}</p>
                <p class="cta-row">
                  <a class="button button--primary" href={routePath('contribute', locale)}>
                    {c.speakersCta}
                  </a>
                  <a class="button" href="#aanmelden">
                    {c.speakersMailCta}
                  </a>
                </p>
              </div>
            ) : (
              <ul class="speakers" role="list">
                {speakers.map((speaker) => (
                  <li>
                    <p class="speaker-name">{speaker.name}</p>
                    {speaker.affiliation && (
                      <p class="speaker-affiliation">{speaker.affiliation}</p>
                    )}
                    {speaker.talk && <p class="speaker-talk">{speaker.talk[locale]}</p>}
                  </li>
                ))}
              </ul>
            )
          }
        </section>

        <section class="release-section reveal" id="locatie">
          <p class="label-mono section-index">{num('locatie')}</p>
          <h2>{c.locationTitle}</h2>
          <VenueMap locale={locale} release={release} />
        </section>

        <section class="release-section reveal" id="aanmelden">
          <p class="label-mono section-index">{num('aanmelden')}</p>
          <h2>{c.registrationTitle}</h2>
          {
            registrationOpen ? (
              <>
                <p>{c.registrationOpenBody}</p>
                <p class="cta-row">
                  <a class="button button--primary" href={REGISTRATION_URL} rel="noopener">
                    {c.registrationCta}
                  </a>
                </p>
              </>
            ) : (
              <>
                <p class="registration-opens">
                  {c.registrationOpens}{' '}
                  <strong>
                    <time datetime={opensIso}>{opensOn}</time>
                  </strong>{' '}
                  {c.registrationOpensSuffix}
                  {MEETUP_GROUP_URL && ` ${c.registrationJoinGroup}`}
                </p>
                {MEETUP_GROUP_URL && (
                  <p class="cta-row">
                    <a class="button button--primary" href={MEETUP_GROUP_URL} rel="noopener">
                      {c.meetupGroupCta}
                    </a>
                  </p>
                )}
                <p>
                  <a href={routePath('events', locale)}>{c.registrationCalendarHint}</a>
                </p>
              </>
            )
          }
          <div class="updates">
            <h3>{c.updatesTitle}</h3>
            <p>{c.updatesBody}</p>
            <NewsletterForm locale={locale} id="release-updates" />
            <p class="consent-note">{c.consentNote}</p>
          </div>
        </section>

        <section class="release-section reveal" id="praktisch">
          <p class="label-mono section-index">{num('praktisch')}</p>
          <h2>{c.practicalTitle}</h2>
          <dl class="practical">
            {
              c.practical.map(({ term, detail }) => (
                <div>
                  <dt>{term}</dt>
                  <dd>{detail}</dd>
                </div>
              ))
            }
          </dl>
          <p class="safeguard-links">
            <a href={routePath('conduct', locale)}>{c.conductCta}</a>
            <a href={routePath('partners', locale)}>{c.partnersCta}</a>
          </p>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .release {
    padding-block-end: var(--space-8);
  }

  .breadcrumb {
    padding-block-end: var(--space-6);
  }

  .breadcrumb a {
    color: var(--fg-subtle);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent-strong);
  }

  .release-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 64rem) {
    .release-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      column-gap: var(--space-8);
      align-items: start;
    }

    .release-hero {
      grid-column: 1;
      grid-row: 1;
    }

    .release-aside {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: stretch;
      height: 100%;
    }

    .release-main {
      grid-column: 1;
      grid-row: 2;
    }

    .release-aside-inner {
      position: sticky;
      top: calc(var(--header-height-compact) + var(--space-5));
    }
  }

  .release-hero {
    padding-block: var(--space-5) var(--space-7);
    border-block-end: var(--border-width) solid var(--border);
  }

  .release-lockup {
    display: inline-grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    background: var(--signal-red);
    color: var(--accent-fg);
    border-radius: var(--radius-md);
    will-change: transform;
  }

  .lockup-name {
    font-weight: 700;
  }

  .lockup-date {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
  }

  .release-hero h1 {
    margin-block: var(--space-5) var(--space-4);
    max-width: 12ch;
  }

  .release-intro {
    color: var(--fg-muted);
    max-width: var(--width-prose);
  }

  .outcomes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
  }

  .outcomes li {
    padding: var(--space-2) var(--space-4);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 550;
    background: var(--bg-subtle);
  }

  .release-aside-inner {
    display: grid;
    gap: var(--space-4);
  }

  .aside-card {
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
  }

  .facts {
    display: grid;
    margin: 0;
  }

  .facts > div {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
  }

  .facts > div + div {
    border-block-start: var(--border-width) solid var(--border);
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--fg-subtle);
  }

  .facts dd {
    margin: 0;
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  .facts dd a {
    color: inherit;
    text-decoration-color: var(--border-strong);
  }

  .facts dd a:hover {
    color: var(--accent-strong);
  }

  .facts .fact-long {
    font-weight: 400;
    color: var(--fg-muted);
  }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }

    .facts > div:nth-child(odd) + div {
      border-block-start: 0;
      border-inline-start: var(--border-width) solid var(--border);
    }

    .facts > div:nth-child(2) ~ div {
      border-block-start: var(--border-width) solid var(--border);
    }
  }

  .aside-cta {
    width: calc(100% - 2 * var(--space-4));
    margin: var(--space-4) var(--space-4) 0;
  }

  .aside-card > .aside-cta:last-child {
    margin-block-end: var(--space-4);
  }

  .aside-note {
    padding: var(--space-3) var(--space-4) var(--space-4);
    color: var(--fg-subtle);
    font-size: var(--text-sm);
    text-align: center;
  }

  .aside-note time {
    color: var(--fg);
    font-weight: var(--weight-semibold);
  }

  .aside-index {
    padding: var(--space-3) var(--space-4) var(--space-2);
  }

  .aside-index-title {
    color: var(--fg-subtle);
    padding-block-end: var(--space-2);
  }

  .aside-index ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

