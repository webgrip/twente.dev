---
import type { Locale } from '../i18n/config.ts';
import { otherLocales, useTranslations } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

/**
 * Static search (plan lever L8), one page per locale.
 *
 * Pagefind builds its index from `dist/` after `astro build` (see the
 * `build` script), so `/pagefind/*` only exists on the built site — under
 * `astro dev` the loader script 404s and the noscript-style fallback text
 * shows instead. The CSP additions that admit the same-origin script, its
 * stylesheet and its WASM live in astro.config.mjs.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Pagefind indexed the pages under their BCP 47 lang tags (nl-NL / en-GB);
// constraining results to the current locale keeps the two language trees
// from bleeding into each other's results. The page copy says so honestly
// ("in het Nederlands" / "in English") and cross-links the other locale's
// search — it used to promise "both languages", which this config never did.
const pagefindConfig = {
  element: '#pagefind-search',
  showSubResults: true,
  translations: {
    placeholder: t('search.placeholder'),
    zero_results: t('search.noResults'),
  },
};

const otherSearch = otherLocales(locale).map((target) => ({
  locale: target,
  href: routePath('search', target),
}));
---

<BaseLayout
  locale={locale}
  routeKey="search"
  title={t('search.label')}
  description={t('search.description')}
  noindex
>
  <div class="container">
    <PageHeader title={t('search.label')} description={t('search.description')} />

    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    <div id="pagefind-search">
      {
        /* Shown to no-JS visitors (and under `astro dev`, where /pagefind/*
          does not exist yet — dev builds surface the same honest fallback). */
      }
      <p class="search-fallback">{t('search.unavailable')}</p>
    </div>

    <p class="other-locale">
      {otherSearch.map((target) => <a href={target.href}>{t('search.otherLocale')} →</a>)}
    </p>

    {
      /* Deferred: 120KB of parser-blocking classic script held up first paint.
        Init waits for DOMContentLoaded, which also replaces the old
        `typeof PagefindUI` race guard. No programmatic focus: stealing focus
        into the input on load bypassed the skip link, header and h1. */
    }
    <script is:inline defer src="/pagefind/pagefind-ui.js"></script>
    <script is:inline define:vars={{ pagefindConfig }}>
      document.addEventListener('DOMContentLoaded', () => {
        if (typeof PagefindUI !== 'undefined') {
          document.querySelector('.search-fallback')?.remove();
          new PagefindUI(pagefindConfig);
        }
      });
    </script>
  </div>
</BaseLayout>

<style>
  .search-fallback {
    color: var(--fg-muted);
  }

  .other-locale {
    margin-block-start: var(--space-4);
    font-size: var(--text-sm);
  }

  #pagefind-search {
    /* Map Pagefind's theming hooks onto the design tokens so results render
       in both themes without touching its stylesheet. --accent-strong, not
       --accent: Pagefind uses "primary" for result-link text, and raw signal
       red as text misses AA on dark surfaces. */
    --pagefind-ui-primary: var(--accent-strong);
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--bg-raised);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--bg-subtle);
    --pagefind-ui-border-width: var(--border-width);
    --pagefind-ui-border-radius: var(--radius-md);
    --pagefind-ui-font: var(--font-sans);
    max-width: var(--width-prose);
    min-height: 24rem;
  }
</style>
