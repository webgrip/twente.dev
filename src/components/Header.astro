---
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/utils.ts';
import type { SlugInput } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import type { RouteKey } from '../i18n/routes.ts';
import LocaleSwitcher from './LocaleSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  current: RouteKey;
  slug?: SlugInput;
}

const { locale, current, slug } = Astro.props;
const t = useTranslations(locale);

const navItems: { key: RouteKey; label: string }[] = [
  { key: 'events', label: t('nav.events') },
  { key: 'jobs', label: t('nav.jobs') },
  { key: 'companies', label: t('nav.companies') },
  { key: 'communities', label: t('nav.communities') },
  { key: 'blog', label: t('nav.blog') },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={routePath('home', locale)}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">{t('site.name')}</span>
    </a>

    <nav class="site-nav" aria-label={t('nav.menu')}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={routePath(item.key, locale)}
                aria-current={item.key === current ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <ThemeToggle locale={locale} />
      <LocaleSwitcher locale={locale} routeKey={current} slug={slug} />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-block-end: var(--border-width) solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 4rem;
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--fg);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    margin-inline-end: auto;
  }

  /* The Twente flag's red pales, reduced to a mark. */
  .brand-mark {
    width: 0.85rem;
    height: 1.35rem;
    border-radius: 2px;
    background: repeating-linear-gradient(
      180deg,
      var(--twente-red) 0 0.3rem,
      var(--bg) 0.3rem 0.45rem
    );
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .site-nav a {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    padding-block: var(--space-2);
    border-block-end: 2px solid transparent;
  }

  .site-nav a:hover {
    color: var(--fg);
  }

  .site-nav a[aria-current='page'] {
    color: var(--fg);
    border-block-end-color: var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (max-width: 47.99rem) {
    .header-inner {
      padding-block: var(--space-3);
    }

    .site-nav {
      order: 3;
      width: 100%;
    }

    .site-nav ul {
      gap: var(--space-3);
    }
  }
</style>
