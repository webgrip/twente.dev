{
  "name": "@webgrip/twente.dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "twente.dev — the homepage for software developers in Twente. Bilingual (NL/EN) static community hub and blog.",
  "repository": {
    "type": "git",
    "url": "https://forgejo.webgrip.dev/webgrip/twente.dev.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "packageManager": "pnpm@11.11.0",
  "prettier": "@webgrip/prettier-config",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pnpm run licenses:bundle && pnpm run index:search && pnpm run validate:csp && pnpm run validate:commitments && pnpm run copy:check && pnpm run validate:copy",
    "licenses:bundle": "node scripts/third-party-licenses.mjs",
    "license:check": "node scripts/license-check.mjs",
    "license:reuse": "uvx --from 'reuse[charset-normalizer]==6.2.0' reuse lint",
    "index:search": "pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --experimental-strip-types \"src/lib/**/*.test.ts\"",
    "validate:content": "node --experimental-strip-types scripts/validate-content.ts",
    "validate:docs": "node --experimental-strip-types scripts/validate-docs-links.ts",
    "validate:renovate-coverage": "node scripts/renovate-coverage.mjs",
    "validate:csp": "webgrip-validate-csp",
    "validate:mail-auth": "webgrip-validate-mail-auth",
    "validate:mta-sts": "node --experimental-strip-types scripts/validate-mta-sts.ts",
    "validate:mail": "node --experimental-strip-types scripts/build-mail.ts --check",
    "map:venue": "node scripts/render-venue-map.mjs",
    "banners": "node --experimental-strip-types scripts/sync-release.mjs && node scripts/export-banners.mjs",
    "gen:ops": "node --experimental-strip-types scripts/gen-ops.ts",
    "mail": "node --experimental-strip-types scripts/build-mail.ts",
    "mail:draft": "node --experimental-strip-types scripts/mail-draft.ts",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "validate:a11y": "node --experimental-strip-types scripts/axe-scan.ts",
    "validate:commitments": "node --experimental-strip-types scripts/validate-commitments.ts",
    "copy": "node --experimental-strip-types scripts/gen-copy.ts",
    "copy:check": "node --experimental-strip-types scripts/gen-copy.ts --check",
    "copy:drift": "node --experimental-strip-types scripts/copy-drift.ts",
    "validate:copy": "node --experimental-strip-types scripts/validate-copy.ts"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.3.5",
    "web-vitals": "6.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@webgrip/astro-site-toolkit": "0.6.0",
    "@webgrip/eslint-config-astro": "0.2.0",
    "@webgrip/prettier-config": "0.3.0",
    "@webgrip/tsconfig": "0.2.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "pagefind": "1.5.2",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "wrangler": "4.118.0",
    "yaml": "2.9.0"
  }
}
