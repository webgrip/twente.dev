---
import type { Locale } from '../i18n/config.ts';
import { formatDateTime, useTranslations } from '../i18n/utils.ts';
import { eventPath } from '../lib/content.ts';
import type { EventEntry } from '../lib/content.ts';
import Tag from './Tag.astro';

interface Props {
  event: EventEntry;
  locale: Locale;
  headingLevel?: 'h2' | 'h3' | 'h4';
}

const { event, locale, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const t = useTranslations(locale);
const href = eventPath(event, locale);

const isOwnRelease = event.data.attribution === 'own';
---

<article
  class:list={[
    'event-card',
    isOwnRelease && 'is-own-release',
    event.data.cancelled && 'is-cancelled',
  ]}
>
  <p class="event-date">
    <time datetime={event.data.start.toISOString()}>
      {formatDateTime(event.data.start, locale)}
    </time>
  </p>

  <Heading class="event-title">
    <a href={href}>{event.data.title[locale]}</a>
  </Heading>

  <p class="event-venue">
    {
      event.data.venue.online
        ? 'Online'
        : event.data.venue.name
          ? `${event.data.venue.name}, ${event.data.venue.city}`
          : `${t('release.venueTba')}, ${event.data.venue.city}`
    }
  </p>

  {
    event.data.attribution === 'listed' && (
      <p class="event-credit">
        {t('events.organisedBy')} {event.data.organiser.name}
      </p>
    )
  }
  {
    event.data.attribution === 'collaboration' && (
      <p class="event-credit">{t('events.inCollaboration')}</p>
    )
  }

  <ul class="event-tags">
    {
      event.data.fixture && (
        <li>
          <Tag>{t('common.fixture')}</Tag>
        </li>
      )
    }
    {
      event.data.cancelled && (
        <li>
          <Tag variant="accent">{t('events.cancelled')}</Tag>
        </li>
      )
    }
    {
      event.data.costEur === 0 && (
        <li>
          <Tag>{t('events.free')}</Tag>
        </li>
      )
    }
    <li>
      <Tag variant="muted"
        >{event.data.language === 'both' ? 'NL / EN' : event.data.language.toUpperCase()}</Tag
      >
    </li>
    {
      event.data.tags.slice(0, 3).map((tag) => (
        <li>
          <Tag>{tag}</Tag>
        </li>
      ))
    }
  </ul>
</article>

<style>
  .event-card {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-raised);
    border-inline-start: 3px solid var(--border-strong);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .event-card:hover {
    border-block-color: var(--border-strong);
    border-inline-end-color: var(--border-strong);
  }

  .event-card:focus-within {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .event-date {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .is-own-release {
    border-inline-start-color: var(--accent);
    background: var(--bg-subtle);
  }

  .is-own-release .event-date {
    color: var(--accent-strong);
    font-weight: 700;
  }

  .is-own-release .event-title {
    font-size: var(--text-xl);
  }

  .is-cancelled {
    border-inline-start-color: var(--border);
    opacity: 0.75;
  }

  .is-cancelled .event-title a {
    text-decoration: line-through;
  }

  .event-title {
    font-size: var(--text-lg);
    margin: 0;
  }

  .event-title a {
    color: var(--fg);
    text-decoration: none;
  }

  .event-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .event-title a:focus-visible {
    outline: none;
  }

  .event-venue {
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .event-credit {
    color: var(--fg-subtle);
    font-size: var(--text-xs);
  }

  .event-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-1);
  }
</style>
