---
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import { CONTACT_EMAIL, NEWSLETTER_FORM_ACTION, NEWSLETTER_FORM_FIELDS } from '../config/site.ts';

interface Props {
  locale: Locale;
  id: string;
}

const { locale, id } = Astro.props;
const t = useTranslations(locale);
const subject = `Field note ${locale === 'nl' ? 'nieuwsbrief' : 'newsletter'}`;
---

<div class="subscribe">
  {
    NEWSLETTER_FORM_ACTION ? (
      <Fragment>
        <form
          class="subscribe-form"
          action={NEWSLETTER_FORM_ACTION}
          method="post"
          data-newsletter-form
          data-status-id={`${id}-status`}
          data-sending={t('newsletter.sending')}
          data-success={t('newsletter.success')}
          data-error={`${t('newsletter.error')} ${CONTACT_EMAIL}.`}
        >
          {Object.entries(NEWSLETTER_FORM_FIELDS).map(([name, value]) => (
            <input type="hidden" name={name} value={value} />
          ))}
          <input type="hidden" name="locale" value={locale} />
          <input type="hidden" name="TAAL" value={locale} />
          <p class="subscribe-hp" aria-hidden="true">
            <label for={`${id}-check`}>Leave this empty</label>
            <input
              id={`${id}-check`}
              type="text"
              name="email_address_check"
              tabindex="-1"
              autocomplete="off"
            />
          </p>
          <p class="subscribe-field">
            <label class="label-mono" for={`${id}-email`}>
              {t('newsletter.emailLabel')}
            </label>
            <input
              id={`${id}-email`}
              type="email"
              name="EMAIL"
              required
              autocomplete="email"
              placeholder="jij@voorbeeld.nl"
            />
          </p>
          <button class="button button--primary" type="submit">
            {t('newsletter.subscribe')}
          </button>
        </form>
        <p class="subscribe-status" id={`${id}-status`} role="status" aria-live="polite" hidden />
      </Fragment>
    ) : (
      <p class="subscribe-pending">
        {t('newsletter.pendingNote')}{' '}
        <a href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}`}>
          {t('newsletter.mailFallback')}
        </a>
      </p>
    )
  }

  <p class="subscribe-note">
    {t('newsletter.consentNote')}{' '}
    <a href={routePath('privacy', locale)}>{t('newsletter.privacyLink')}</a>
  </p>
</div>

<script>
  const forms = document.querySelectorAll('form[data-newsletter-form]');

  for (const form of forms) {
    if (!(form instanceof HTMLFormElement)) continue;

    const statusId = form.dataset.statusId;
    const status = statusId ? document.getElementById(statusId) : null;
    if (!status) continue;

    const button = form.querySelector('button[type="submit"]');

    const show = (state: string, message: string | undefined) => {
      status.hidden = false;
      status.className = `subscribe-status is-${state}`;
      status.textContent = message ?? '';
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (button instanceof HTMLButtonElement) button.disabled = true;
      show('busy', form.dataset.sending);

      const postWithoutJavaScript = () => HTMLFormElement.prototype.submit.call(form);

      try {
        const body = new URLSearchParams();
        for (const [key, value] of new FormData(form)) {
          if (typeof value === 'string') body.append(key, value);
        }

        const response = await fetch(form.action, { method: 'POST', body });
        const raw = await response.text();

        if (!response.ok) {
          throw new Error(`provider returned ${response.status}: ${raw.slice(0, 300)}`);
        }

        let payload: unknown = null;
        try {
          payload = JSON.parse(raw);
        } catch {
          payload = null;
        }

        if (payload && typeof payload === 'object' && 'success' in payload) {
          if ((payload as { success?: unknown }).success === false) {
            throw new Error(`provider rejected the address: ${raw.slice(0, 300)}`);
          }
        }

        show('ok', form.dataset.success);
        form.hidden = true;
      } catch (error) {
        console.warn(
          '[newsletter] background subscribe failed, retrying as a plain form post.',
          error,
        );
        postWithoutJavaScript();
      }
    });
  }
</script>

<style>
  .subscribe-form {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-3);
  }

  .subscribe-form[hidden] {
    display: none;
  }

  .subscribe-field {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    flex: 1 1 18rem;
  }

  .subscribe-field label {
    color: var(--fg-subtle);
  }

  .subscribe-field input {
    width: 100%;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--fg);
    font-family: inherit;
    line-height: var(--leading-normal);
  }

  .subscribe-hp {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .subscribe-pending {
    margin: 0;
  }

  .subscribe-note {
    color: var(--fg-subtle);
    font-size: var(--text-sm);
    margin-block: var(--space-3) 0;
    max-width: var(--width-prose);
  }

  .subscribe-status {
    margin-block: var(--space-3) 0;
    padding: var(--space-3);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-subtle);
    font-size: var(--text-sm);
    max-width: var(--width-prose);
  }

  .subscribe-status.is-busy {
    color: var(--fg-subtle);
  }

  .subscribe-status.is-error {
    border-color: var(--accent);
  }
</style>
