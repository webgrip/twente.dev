---
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/utils.ts';
import { getPastEvents, getUpcomingEvents } from '../lib/content.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EventCard from '../components/EventCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const [upcoming, past] = await Promise.all([getUpcomingEvents(), getPastEvents()]);
---

<BaseLayout
  locale={locale}
  routeKey="events"
  title={t('events.title')}
  description={t('events.description')}
>
  <div class="container">
    <PageHeader title={t('events.title')} description={t('events.description')}>
      <a class="ics-link" href="/events.ics">
        {t('events.subscribe')}
        <span class="ics-hint">{t('events.subscribeHint')}</span>
      </a>
    </PageHeader>

    <h2>{t('events.upcoming')}</h2>
    <div class="event-grid">
      {upcoming.length === 0 && <p class="empty">{t('events.empty')}</p>}
      {upcoming.map((event) => <EventCard event={event} locale={locale} />)}
    </div>

    {
      past.length > 0 && (
        <>
          <h2 class="past-heading">{t('events.past')}</h2>
          <div class="event-grid">
            {past.slice(0, 12).map((event) => (
              <EventCard event={event} locale={locale} />
            ))}
          </div>
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .ics-link {
    display: inline-flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-block-start: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 550;
  }

  .ics-link:hover {
    background: var(--bg-subtle);
  }

  .ics-hint {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--fg-subtle);
  }

  h2 {
    font-size: var(--text-xl);
    margin-block-end: var(--space-4);
  }

  .past-heading {
    margin-block-start: var(--space-8);
  }

  .event-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .event-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .empty {
    color: var(--fg-muted);
  }
</style>
