---
import type { Locale } from '../i18n/config.ts';
import { formatDate, useTranslations } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import { postSlug } from '../lib/content.ts';
import type { PostEntry } from '../lib/content.ts';

interface Props {
  post: PostEntry;
  locale: Locale;
  /** Heading level of the card title — h2 on list pages, h3 under a section. */
  headingLevel?: 'h2' | 'h3';
}

const { post, locale, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const t = useTranslations(locale);
const href = routePath('blog', locale, postSlug(post));
---

<article class="post-card">
  {post.data.pillar && <p class="post-pillar label-mono">{t(`pillar.${post.data.pillar}`)}</p>}
  <Heading class="post-title"><a href={href}>{post.data.title}</a></Heading>
  <p class="post-desc">{post.data.description}</p>
  <p class="post-meta">
    <time datetime={post.data.publishedAt.toISOString()}>
      {formatDate(post.data.publishedAt, locale)}
    </time>
    <span aria-hidden="true">·</span>
    <span>{t('blog.by')} {post.data.author.name}</span>
  </p>
</article>

<style>
  .post-card {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-block-end: var(--border-width) solid var(--border);
  }

  .post-card:focus-within {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  /* Register comes from the global .label-mono class; only the color is ours. */
  .post-pillar {
    color: var(--fg-subtle);
  }

  .post-title {
    font-size: var(--text-xl);
    margin: 0;
  }

  .post-title a {
    color: var(--fg);
    text-decoration: none;
  }

  .post-title a:hover {
    /* The text-safe red cut — raw --accent as text fails contrast on ink. */
    color: var(--accent-strong);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .post-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-title a:focus-visible {
    outline: none;
  }

  .post-desc {
    color: var(--fg-muted);
  }

  .post-meta {
    color: var(--fg-subtle);
    font-size: var(--text-sm);
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
</style>
