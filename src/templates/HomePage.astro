---
import type { Locale } from '../i18n/config.ts';
import { formatDate, useTranslations } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import { getPosts, getUpcomingEvents } from '../lib/content.ts';
import {
  CONTACT_EMAIL,
  EDITION_001,
  NEWSLETTER_URL,
  REGISTRATION_OPENS,
  editionName,
} from '../config/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import EventCard from '../components/EventCard.astro';
import PostCard from '../components/PostCard.astro';

/**
 * The playbook's contract for this page: promise, explanation, next event,
 * proof, partners, contribution CTA — and a new visitor reaches RSVP or
 * contribute in two clicks.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const [events, posts] = await Promise.all([getUpcomingEvents(), getPosts(locale)]);

const edition = `${editionName(EDITION_001.number)} — ${EDITION_001.theme}`;
---

<BaseLayout
  locale={locale}
  routeKey="home"
  title={t('site.name')}
  description={t('site.description')}
>
  <div class="hero">
    <div class="container">
      <h1>{t('home.hero.title')}</h1>
      <p class="hero-subtitle">{t('home.hero.subtitle')}</p>
      <div class="hero-actions">
        <a class="button button--primary" href={routePath('edition001', locale)}>
          {t('home.hero.ctaReserve')}
        </a>
        <a class="button" href={routePath('contribute', locale)}>
          {t('home.hero.ctaContribute')}
        </a>
      </div>
      <ul class="outcomes" role="list">
        <li>{t('home.outcome.idea')}</li>
        <li>{t('home.outcome.intro')}</li>
        <li>{t('home.outcome.return')}</li>
      </ul>
    </div>
  </div>

  <div class="container">
    <section class="next-edition" aria-labelledby="next-edition-title">
      <p class="kicker">{t('home.next.kicker')}</p>
      <h2 id="next-edition-title">{edition}</h2>
      <p class="edition-facts">
        <time datetime={EDITION_001.doors.toISOString()}>
          {formatDate(EDITION_001.doors, locale)}
        </time>
        {' · '}18:00–21:30 · {EDITION_001.city} ·
        {EDITION_001.venue ?? t('edition.venueTba')} · {t('events.free')}
      </p>
      <p class="edition-facts">{t('edition.language')}</p>
      <p class="edition-registration">
        {t('edition.registrationOpens')}
        <strong>
          <time datetime={REGISTRATION_OPENS.toISOString()}>
            {formatDate(REGISTRATION_OPENS, locale)}
          </time>
        </strong>
      </p>
      <a class="edition-link" href={routePath('edition001', locale)}>{t('edition.details')} →</a>
    </section>

    <section class="what" aria-labelledby="what-title">
      <h2 id="what-title">{t('home.what.title')}</h2>
      <p>{t('home.what.body')}</p>
    </section>

    <Section
      title={t('home.events.title')}
      linkHref={routePath('events', locale)}
      linkLabel={t('home.events.all')}
    >
      {events.length === 0 && <p class="empty">{t('events.empty')}</p>}
      {events.slice(0, 4).map((event) => <EventCard event={event} locale={locale} />)}
    </Section>

    <section class="community-band" aria-labelledby="community-band-title">
      <h2 id="community-band-title">{t('home.community.title')}</h2>
      <p>{t('home.community.body')}</p>
      <a href={routePath('communities', locale)}>{t('common.viewAll')} →</a>
    </section>

    <Section
      title={t('home.posts.title')}
      linkHref={routePath('blog', locale)}
      linkLabel={t('home.posts.all')}
      columns={1}
    >
      {posts.length === 0 && <p class="empty">{t('blog.empty')}</p>}
      {posts.slice(0, 3).map((post) => <PostCard post={post} locale={locale} />)}
    </Section>

    <section class="newsletter" aria-labelledby="newsletter-title">
      <h2 id="newsletter-title">{t('home.newsletter.title')}</h2>
      <p>{t('home.newsletter.body')}</p>
      {
        NEWSLETTER_URL ? (
          <a class="button" href={NEWSLETTER_URL}>
            {t('newsletter.subscribe')}
          </a>
        ) : (
          <a class="button" href={`mailto:${CONTACT_EMAIL}?subject=Field%20note%20newsletter`}>
            {t('newsletter.mailFallback')}
          </a>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
    background: var(--bg);
    border-block-end: var(--border-width) solid var(--border);
  }

  .hero h1 {
    max-width: 22ch;
  }

  .hero-subtitle {
    margin-block-start: var(--space-4);
    font-size: var(--text-lg);
    color: var(--fg-muted);
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-5);
  }

  .outcomes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
  }

  .outcomes li {
    padding: var(--space-1) var(--space-3);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    background: var(--bg-subtle);
    color: var(--fg-muted);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding-inline: var(--space-5);
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--border-strong);
    background: var(--bg-raised);
    color: var(--fg);
    font-weight: 550;
    text-decoration: none;
  }

  .button:hover {
    background: var(--bg-subtle);
    color: var(--fg);
  }

  /* The page's one red signal: the action that fills the room. */
  .button--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-fg);
  }

  .button--primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: var(--accent-fg);
  }

  .next-edition {
    margin-block-start: var(--space-7);
    padding: var(--space-5);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-subtle);
  }

  .next-edition h2 {
    margin-block: var(--space-1) var(--space-3);
  }

  .edition-facts {
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .edition-registration {
    margin-block-start: var(--space-3);
  }

  .edition-link {
    display: inline-block;
    margin-block-start: var(--space-2);
    font-weight: 550;
  }

  .what,
  .community-band {
    margin-block-start: var(--space-7);
    max-width: var(--width-prose);
  }

  .what p,
  .community-band p {
    color: var(--fg-muted);
    margin-block: var(--space-3);
  }

  .newsletter {
    margin-block-start: var(--space-7);
    padding: var(--space-5);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
    max-width: var(--width-prose);
  }

  .newsletter p {
    color: var(--fg-muted);
    margin-block: var(--space-3);
  }

  .empty {
    color: var(--fg-muted);
    grid-column: 1 / -1;
  }
</style>
