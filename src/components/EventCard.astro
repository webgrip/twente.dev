---
import type { Locale } from '../i18n/config.ts';
import { formatDateTime, useTranslations } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import type { EventEntry } from '../lib/content.ts';
import Tag from './Tag.astro';

interface Props {
  event: EventEntry;
  locale: Locale;
}

const { event, locale } = Astro.props;
const t = useTranslations(locale);
// A flagship edition's canonical home is its bespoke page, never a generated
// detail page — one listing, synchronised everywhere.
const href = event.data.canonicalRoute
  ? routePath(event.data.canonicalRoute, locale)
  : routePath('events', locale, event.id);
---

<article class:list={['event-card', event.data.cancelled && 'is-cancelled']}>
  <p class="event-date">
    <time datetime={event.data.start.toISOString()}>
      {formatDateTime(event.data.start, locale)}
    </time>
  </p>

  <h3 class="event-title">
    <a href={href}>{event.data.title[locale]}</a>
  </h3>

  <p class="event-venue">
    {event.data.venue.online ? 'Online' : `${event.data.venue.name}, ${event.data.venue.city}`}
  </p>

  {event.data.attribution === 'listed' && <p class="event-credit">{t('events.listedBy')}</p>}
  {
    event.data.attribution === 'collaboration' && (
      <p class="event-credit">{t('events.inCollaboration')}</p>
    )
  }

  <ul class="event-tags">
    {
      event.data.cancelled && (
        <li>
          <Tag variant="accent">{t('events.cancelled')}</Tag>
        </li>
      )
    }
    {
      event.data.costEur === 0 && (
        <li>
          <Tag>{t('events.free')}</Tag>
        </li>
      )
    }
    <li>
      <Tag variant="muted"
        >{event.data.language === 'both' ? 'NL / EN' : event.data.language.toUpperCase()}</Tag
      >
    </li>
    {
      event.data.tags.slice(0, 3).map((tag) => (
        <li>
          <Tag>{tag}</Tag>
        </li>
      ))
    }
  </ul>
</article>

<style>
  .event-card {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    border-inline-start: 3px solid var(--accent);
  }

  .event-card:hover {
    border-color: var(--border-strong);
    border-inline-start-color: var(--accent);
  }

  .event-card:focus-within {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .is-cancelled {
    border-inline-start-color: var(--border-strong);
    opacity: 0.75;
  }

  .is-cancelled .event-title a {
    text-decoration: line-through;
  }

  .event-date {
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .event-title {
    font-size: var(--text-lg);
    margin: 0;
  }

  .event-title a {
    color: var(--fg);
    text-decoration: none;
  }

  .event-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .event-title a:focus-visible {
    outline: none;
  }

  .event-venue {
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .event-credit {
    color: var(--fg-subtle);
    font-size: var(--text-xs);
  }

  .event-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-1);
  }
</style>
