---
import ProsePage from '../../templates/ProsePage.astro';
import { CONTACT_EMAIL, REPO_URL } from '../../config/site.ts';
---

<ProsePage
  locale="nl"
  routeKey="contribute"
  title="Bijdragen"
  description="Bijdragen is hoe deze community groeit. De volledige routes werken we nog uit — mailen kan altijd."
>
  <p>
    Bijdragen is hoe deze community groeit: een verhaal, een demo, een introductie, een vermeld
    event, een vrijwilligersshift, een zaal. We werken de routes op dit moment uit; deze pagina
    groeit mee.
  </p>
  <p>
    Nu al iets bijdragen? Mail <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> — één zin is genoeg
    om het gesprek te starten. Iets kapot of onjuist op de site gevonden?
    <a href={REPO_URL}>Open een issue in de repository</a>.
  </p>
</ProsePage>
