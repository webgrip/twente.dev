---
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import type { CompanyEntry, JobEntry } from '../lib/content.ts';
import { breadcrumbSchema, organizationSchemaForCompany } from '../lib/jsonld.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';
import JobCard from '../components/JobCard.astro';

interface Props {
  company: CompanyEntry;
  jobs: JobEntry[];
  locale: Locale;
}

const { company, jobs, locale } = Astro.props;
const t = useTranslations(locale);

const jsonLd = [
  organizationSchemaForCompany(company, locale),
  breadcrumbSchema([
    { name: t('nav.home'), path: routePath('home', locale) },
    { name: t('companies.title'), path: routePath('companies', locale) },
    { name: company.data.name, path: routePath('companies', locale, company.id) },
  ]),
];

const socialLinks = Object.entries(company.data.socials ?? {}).filter(
  (entry): entry is [string, string] => Boolean(entry[1]),
);
---

<BaseLayout
  locale={locale}
  routeKey="companies"
  slug={company.id}
  title={company.data.name}
  description={company.data.description[locale].slice(0, 200)}
  jsonLd={jsonLd}
>
  <div class="container detail">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={routePath('companies', locale)}>{t('companies.title')}</a>
    </nav>

    <header class="detail-header">
      <div class="title-row">
        <h1>{company.data.name}</h1>
        {company.data.hiring && <Tag variant="accent">{t('companies.hiring')}</Tag>}
      </div>
      <p class="lede">{company.data.description[locale]}</p>
    </header>

    <dl class="facts">
      <div>
        <dt>{t('companies.locations')}</dt>
        <dd>{company.data.locations.join(', ')}</dd>
      </div>
      <div>
        <dt>{t('companies.size')}</dt>
        <dd>{company.data.size}</dd>
      </div>
      <div>
        <dt>{t('companies.website')}</dt>
        <dd><a href={company.data.website} rel="noopener">{company.data.website}</a></dd>
      </div>
    </dl>

    {
      company.data.stack.length > 0 && (
        <section>
          <h2>{t('companies.stack')}</h2>
          <ul class="stack">
            {company.data.stack.map((tech) => (
              <li>
                <Tag>{tech}</Tag>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      socialLinks.length > 0 && (
        <ul class="socials">
          {socialLinks.map(([name, url]) => (
            <li>
              <a href={url} rel="noopener">
                {name}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      jobs.length > 0 && (
        <section>
          <h2>{t('companies.openJobs')}</h2>
          <div class="job-grid">
            {jobs.map((job) => (
              <JobCard job={job} company={company} locale={locale} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .detail {
    padding-block: var(--space-6);
  }

  .breadcrumb {
    font-size: var(--text-sm);
    margin-block-end: var(--space-4);
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .lede {
    margin-block-start: var(--space-3);
    color: var(--fg-muted);
    font-size: var(--text-lg);
    max-width: var(--width-prose);
  }

  .detail-header {
    padding-block-end: var(--space-5);
    border-block-end: var(--border-width) solid var(--border);
  }

  .facts {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-5);
  }

  @media (min-width: 40rem) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  dt {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  dd {
    margin: var(--space-1) 0 0;
    font-weight: 550;
    overflow-wrap: anywhere;
  }

  section {
    margin-block-start: var(--space-6);
  }

  h2 {
    font-size: var(--text-lg);
    margin-block-end: var(--space-3);
  }

  .stack,
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .socials {
    gap: var(--space-4);
    margin-block-start: var(--space-5);
    font-size: var(--text-sm);
  }

  .job-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .job-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
