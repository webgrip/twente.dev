---
import { LOCALE_TAGS, TIMEZONE } from '../i18n/config.ts';
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import { getPastEvents, getUpcomingEvents } from '../lib/content.ts';
import type { EventEntry } from '../lib/content.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EventCard from '../components/EventCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const [upcoming, past] = await Promise.all([getUpcomingEvents(), getPastEvents()]);

const monthFormatter = new Intl.DateTimeFormat(LOCALE_TAGS[locale], {
  timeZone: TIMEZONE,
  month: 'long',
  year: 'numeric',
});

function groupByMonth(events: EventEntry[]): { label: string; events: EventEntry[] }[] {
  const groups: { label: string; events: EventEntry[] }[] = [];
  for (const event of events) {
    const label = monthFormatter.format(event.data.start);
    const current = groups.at(-1);
    if (current && current.label === label) {
      current.events.push(event);
    } else {
      groups.push({ label, events: [event] });
    }
  }
  return groups;
}

const upcomingGroups = groupByMonth(upcoming);
const pastGroups = groupByMonth(past.slice(0, 12));

const WEBCAL_URL = 'webcal://twente.dev/events.ics';
const GOOGLE_CALENDAR_URL = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(WEBCAL_URL)}`;
---

<BaseLayout
  locale={locale}
  routeKey="events"
  title={t('events.title')}
  description={t('events.description')}
>
  <div class="container">
    <PageHeader
      title={t('events.title')}
      description={t('events.description')}
      kicker={`twente.dev // ${t('events.title').toLowerCase()}`}
    >
      <div class="subscribe">
        <p class="subscribe-title">{t('events.subscribe')}</p>
        <p class="subscribe-hint">{t('events.subscribeHint')}</p>
        <ul class="subscribe-links" role="list">
          <li>
            <a href={GOOGLE_CALENDAR_URL} rel="noopener">{t('events.subscribeGoogle')}</a>
          </li>
          <li><a href={WEBCAL_URL}>{t('events.subscribeWebcal')}</a></li>
          <li><a href="/events.ics">{t('events.subscribeDirect')}</a></li>
        </ul>
      </div>
    </PageHeader>

    <h2 class="visually-hidden">{t('events.upcoming')}</h2>
    {
      upcoming.length === 0 && (
        <p class="empty">
          {t('events.empty')} <a href={routePath('contribute', locale)}>{t('events.emptyCta')}</a>
        </p>
      )
    }

    <div class="timeline">
      {
        upcomingGroups.map((group) => (
          <section class="month-group">
            <h3 class="label-mono month-label">
              <span class="month-dot" aria-hidden="true" />
              {group.label}
            </h3>
            <div class="event-grid">
              {group.events.map((event) => (
                <EventCard event={event} locale={locale} headingLevel="h4" />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    {
      pastGroups.length > 0 && (
        <>
          <h2 class="past-heading">{t('events.past')}</h2>
          <div class="timeline is-past">
            {pastGroups.map((group) => (
              <section class="month-group">
                <h3 class="label-mono month-label">
                  <span class="month-dot" aria-hidden="true" />
                  {group.label}
                </h3>
                <div class="event-grid">
                  {group.events.map((event) => (
                    <EventCard event={event} locale={locale} headingLevel="h4" />
                  ))}
                </div>
              </section>
            ))}
          </div>
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .subscribe {
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
  }

  .subscribe-title {
    font-weight: 650;
  }

  .subscribe-hint {
    font-size: var(--text-sm);
    color: var(--fg-subtle);
    margin-block-start: var(--space-1);
  }

  .subscribe-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 550;
  }

  .timeline {
    position: relative;
    padding-inline-start: var(--space-5);
  }

  .timeline::before {
    content: '';
    position: absolute;
    inset-block: 0.4rem;
    inset-inline-start: 0;
    width: 1px;
    background: var(--border-strong);
  }

  .month-group {
    position: relative;
    padding-block-end: var(--space-7);
  }

  .month-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--fg-muted);
    margin-block-end: var(--space-4);
  }

  .month-dot {
    position: absolute;
    inset-inline-start: calc(-1 * var(--space-5) - 5px);
    inline-size: 11px;
    block-size: 11px;
    border-radius: var(--radius-full);
    background: var(--accent);
    border: 2px solid var(--bg);
  }

  .is-past .month-dot {
    background: var(--border-strong);
  }

  .is-past {
    opacity: 0.72;
  }

  .event-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .event-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .past-heading {
    font-size: var(--text-xl);
    margin-block: var(--space-6) var(--space-4);
  }

  .empty {
    color: var(--fg-muted);
  }
</style>
