---
import ProsePage from '../../templates/ProsePage.astro';
import Confetti from '../../components/Confetti.astro';
import { CONTACT_EMAIL } from '../../config/site.ts';
import { routePath } from '../../i18n/routes.ts';
---

<ProsePage
  locale="en"
  routeKey="confirmed"
  noindex
  title="You are on the list"
  description="Your subscription is confirmed. Here is what you get."
>
  <Confetti />

  <p class="lede"><strong>Confirmed.</strong> Nothing else to do.</p>

  <p>What lands in your inbox:</p>

  <ul>
    <li><strong>Field reports</strong>, interviews with people building something here.</li>
    <li>
      <strong>Release notes</strong> within ten working days of an evening: the slides, the photos and
      what did <em>not</em> work.
    </li>
    <li><strong>Upstream</strong>, what is happening in the region without us.</li>
    <li>An open call when a talk slot is still free.</li>
  </ul>

  <p>
    No fixed cadence. A mail goes out when there is something worth saying. Replies are welcome,
    there is a person on the other end. Unsubscribing takes one click.
  </p>

  <p>
    In the meantime: <a href={routePath('blog', 'en')}>the archive</a>, the
    <a href={routePath('events', 'en')}>calendar</a>, or <a href={routePath('contribute', 'en')}
      >what we could use help with</a
    >. Something wrong? Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
  </p>
</ProsePage>

<style>
  .lede {
    font-size: var(--text-lg);
  }
</style>
