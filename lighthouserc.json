{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/nl.html",
        "http://localhost/en.html",
        "http://localhost/nl/001.html",
        "http://localhost/en/001.html",
        "http://localhost/nl/events.html",
        "http://localhost/nl/communities.html",
        "http://localhost/nl/blog/waarom-twente-dev.html",
        "http://localhost/nl/zoeken.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage",
        "disableFullPageScreenshot": true
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/zoeken\\.html$).*$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "total-byte-weight": ["error", { "maxNumericValue": 131072 }],
            "unused-javascript": ["error", { "maxNumericValue": 10240 }]
          }
        },
        {
          "matchingUrlPattern": ".*/zoeken\\.html$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "total-byte-weight": ["error", { "maxNumericValue": 163840 }],
            "unused-javascript": ["error", { "maxNumericValue": 10240 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-report"
    }
  }
}
