---
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/utils.ts';
import { routePath } from '../i18n/routes.ts';
import { getCommunities } from '../lib/content.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Tag from '../components/Tag.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const communities = await getCommunities();

/**
 * Platform names are proper nouns, so no translation — but the enum's storage
 * values are lowercase, and `other` is meaningless to a visitor. A card with
 * no platform chip communicates more than a chip saying "other".
 */
const PLATFORM_LABELS: Record<string, string | null> = {
  discord: 'Discord',
  slack: 'Slack',
  matrix: 'Matrix',
  telegram: 'Telegram',
  meetup: 'Meetup',
  forum: 'Forum',
  other: null,
};
---

<BaseLayout
  locale={locale}
  routeKey="communities"
  title={t('communities.title')}
  description={t('communities.description')}
>
  <div class="container">
    <PageHeader
      title={t('communities.title')}
      description={t('communities.description')}
      kicker={`twente.dev / ${t('communities.title').toLowerCase()}`}
    />

    <ul class="community-list">
      {
        communities.length === 0 && (
          <li class="empty">
            {t('communities.empty')}{' '}
            <a href={routePath('contribute', locale)}>{t('communities.submit')}</a>
          </li>
        )
      }
      {
        communities.map((community) => (
          <li class="community">
            <div class="community-head">
              <h2>{community.data.name}</h2>
              {PLATFORM_LABELS[community.data.platform] && (
                <Tag variant="muted">{PLATFORM_LABELS[community.data.platform]}</Tag>
              )}
              <Tag variant="muted">
                {community.data.language === 'both'
                  ? 'NL / EN'
                  : community.data.language.toUpperCase()}
              </Tag>
            </div>
            <p class="community-desc">{community.data.description[locale]}</p>
            {/* Ten identical "Word lid →" entries in a screen-reader links
                list are indistinguishable; the aria-label names the target. */}
            <a
              class="community-link"
              href={community.data.url}
              rel="noopener"
              aria-label={`${t('communities.join')} — ${community.data.name}`}
            >
              {t('communities.join')} →
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .community-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }

  .community {
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-raised);
    display: grid;
    gap: var(--space-3);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .community:hover {
    border-color: var(--border-strong);
  }

  .community-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .community-head h2 {
    font-size: var(--text-lg);
    margin: 0;
  }

  .community-desc {
    color: var(--fg-muted);
    max-width: var(--width-prose);
  }

  .community-link {
    font-weight: 550;
    text-decoration: none;
    justify-self: start;
  }

  .community-link:hover {
    text-decoration: underline;
  }

  .empty {
    color: var(--fg-muted);
  }
</style>
